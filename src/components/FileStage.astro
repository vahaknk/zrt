---
import { getPlatformLabels, makeLabelGetter } from '../lib/platformLabels';

// Shows a platform file inside the page: a player for video/audio (no
// download button), images without "save", PDFs in the browser viewer.
// With `trackMaterialId`, playback is reported for the usage numbers.
interface Props {
  file: { id: string; filename: string; kind: string; mime: string; status: string; thumb_key?: string | null };
  title: string;
  canDownload: boolean;
  trackMaterialId?: number | null;
}
const { file, title, canDownload, trackMaterialId = null } = Astro.props;
const L = makeLabelGetter(await getPlatformLabels());
const src = `/api/platform/files/${file.id}`;
const isPdf = file.mime === 'application/pdf' || file.filename.toLowerCase().endsWith('.pdf');
---

<div class="stage" data-no-save>
  {file.kind === 'video' && file.status === 'processing' ? (
    <p class="no-preview">{L('viewer_video_processing', 'Տեսերիզը կը պատրաստուի։ Քանի մը վայրկեանէն կրկին փորձէ։')}</p>
  ) : file.kind === 'audio' && file.status === 'processing' ? (
    <p class="no-preview">{L('viewer_audio_processing', 'Ձայներիզը կը պատրաստուի։ Քանի մը վայրկեանէն կրկին փորձէ։')}</p>
  ) : file.status === 'failed' ? (
    <p class="no-preview">{L('viewer_file_failed', 'Այս ծրարը չկրցանք կարդալ։ Կրկին բեռնէ։')}</p>
  ) : file.kind === 'video' ? (
    <video id="player" src={src} poster={file.thumb_key ? `${src}?thumb=1` : undefined} controls playsinline preload="metadata" controlslist="nodownload noremoteplayback" disablepictureinpicture></video>
  ) : file.kind === 'audio' ? (
    <audio id="player" src={src} controls preload="metadata" controlslist="nodownload"></audio>
  ) : file.kind === 'image' ? (
    <img src={src} alt={title} draggable="false" />
  ) : isPdf ? (
    <iframe src={src} title={title}></iframe>
  ) : (
    <p class="no-preview">{L('viewer_no_preview', 'Այս ծրարը հարթակին վրայ չի կրնար ցուցադրուիլ։')}</p>
  )}
</div>

{canDownload && file.status === 'ready' && (
  <div class="stage-actions">
    <a class="stage-download" href={`${src}?download=1`}>{L('viewer_download', 'Ներբեռնել')}</a>
  </div>
)}

<style>
  .stage { background: #fff; border: 1px solid #e9e9e4; border-radius: 14px; overflow: hidden; }
  .stage video, .stage img { display: block; width: 100%; max-height: 75vh; background: #111; object-fit: contain; }
  .stage img { background: #f7f4ee; user-select: none; -webkit-user-drag: none; -webkit-touch-callout: none; }
  .stage audio { display: block; width: calc(100% - 3rem); margin: 1.5rem auto; }
  .stage iframe { display: block; width: 100%; height: 80vh; border: 0; }
  .stage .no-preview { padding: 2rem 1.5rem; color: #666; font-size: 0.9rem; }
  .stage-actions { margin-top: 1rem; display: flex; justify-content: flex-end; }
  .stage-download { padding: 0.5rem 1.1rem; background: #1a1a1a; color: #fff; border-radius: 999px; font-weight: 700; font-size: 0.8rem; text-decoration: none; }
</style>

<script define:vars={{ materialId: trackMaterialId }}>
  // No right-click "save as" on the media (it can't stop a determined
  // person, but keeps saving from being the obvious thing to do).
  document.querySelector('[data-no-save]')?.addEventListener('contextmenu', (e) => e.preventDefault());

  const player = document.getElementById('player');
  if (player && materialId) {
    // Count only real playback: time advancing in small steps while playing,
    // not jumps from seeking.
    let played = 0;
    let last = null;
    player.addEventListener('timeupdate', () => {
      const t = player.currentTime;
      if (last !== null && !player.paused) {
        const step = t - last;
        if (step > 0 && step < 2) played += step;
      }
      last = t;
    });
    player.addEventListener('seeking', () => (last = player.currentTime));
    const send = (beacon) => {
      if (played < 1 && player.currentTime < 1) return;
      const body = JSON.stringify({ delta: Math.round(played), position: Math.round(player.currentTime), duration: Math.round(player.duration || 0) });
      played = 0;
      const url = `/api/platform/views/${materialId}`;
      if (beacon && navigator.sendBeacon) navigator.sendBeacon(url, new Blob([body], { type: 'application/json' }));
      else fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body, keepalive: true }).catch(() => {});
    };
    setInterval(() => { if (!player.paused) send(false); }, 15000);
    player.addEventListener('pause', () => send(false));
    player.addEventListener('ended', () => send(false));
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') send(true); });
  }
</script>
