---
import { adminGet } from '../lib/directusAdmin';
import {
  getWeekDates,
  buildSessionBlocks,
  gridBounds,
  blockInstants,
  type SessionBlock,
  type WorkshopInfo,
  type CloudInfo,
} from '../lib/calendar';
import { CALENDAR_WEEKDAYS, MONTH_LABELS } from '../lib/minorFormContent';
import { getPlatformLabels, makeLabelGetter } from '../lib/platformLabels';

interface Props {
  workshops: (WorkshopInfo | null)[];
  clouds: CloudInfo[];
  basePath?: string;
}

const { workshops, clouds, basePath = '/platform/calendar' } = Astro.props;
const L = makeLabelGetter(await getPlatformLabels());

const requestedWeek = Astro.url.searchParams.get('week');
const anchor = requestedWeek && !Number.isNaN(Date.parse(requestedWeek)) ? new Date(requestedWeek) : new Date();
const weekDates = getWeekDates(anchor);
const weekStart = weekDates[0];
const weekEnd = weekDates[6];

function ymd(d: Date): string {
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}

const prevWeek = new Date(weekStart.getFullYear(), weekStart.getMonth(), weekStart.getDate() - 7);
const nextWeek = new Date(weekStart.getFullYear(), weekStart.getMonth(), weekStart.getDate() + 7);

let overrides: { date: string; note: string | null; workshop: number | null; cloud: number | null }[] = [];
try {
  const res = await adminGet(
    `/items/schedule_overrides?filter[active][_eq]=true&filter[date][_between]=${ymd(weekStart)},${ymd(weekEnd)}&fields=date,note,workshop,cloud&limit=-1`
  );
  overrides = res.data ?? [];
} catch (e) {
  console.error('Failed to load schedule overrides:', e);
}

const blocks: SessionBlock[] = buildSessionBlocks(workshops, clouds, weekDates);
const bounds = gridBounds(blocks);
const PX_PER_MIN = 1;
const gridHeight = (bounds.endMin - bounds.startMin) * PX_PER_MIN;

const hourMarks: number[] = [];
for (let m = Math.ceil(bounds.startMin / 60) * 60; m <= bounds.endMin; m += 60) hourMarks.push(m);

function fmtHour(min: number): string {
  return `${String(Math.floor(min / 60)).padStart(2, '0')}:${String(min % 60).padStart(2, '0')}`;
}

// Monday-first, matching getWeekDates()'s order.
const WEEKDAY_SHORT = CALENDAR_WEEKDAYS.hyw;
const MONTH_SHORT = MONTH_LABELS.hyw;

const enrichedBlocks = blocks.map((b) => {
  const dateStr = ymd(b.date);
  const override = overrides.find(
    (o) => o.date === dateStr && (b.kind === 'workshop' ? o.workshop === b.sourceId : o.cloud === b.sourceId)
  );
  const dayIndex = Math.round((b.date.getTime() - weekStart.getTime()) / (24 * 60 * 60 * 1000));
  const { start, end } = blockInstants(b);
  return {
    ...b,
    dayIndex,
    cancelled: !!override,
    overrideNote: override?.note ?? null,
    top: (b.startMin - bounds.startMin) * PX_PER_MIN,
    height: Math.max(20, (b.endMin - b.startMin) * PX_PER_MIN),
    startIso: start.toISOString(),
    endIso: end.toISOString(),
  };
});
---

<div class="pcal">
  <div class="weeknav">
    <a href={`${basePath}?week=${ymd(prevWeek)}`}>&larr; {L('calendar_prev_week', 'նախորդ')}</a>
    <span class="range">
      {MONTH_SHORT[weekStart.getMonth()]} {weekStart.getDate()} – {MONTH_SHORT[weekEnd.getMonth()]} {weekEnd.getDate()}
    </span>
    <a href={`${basePath}?week=${ymd(nextWeek)}`}>{L('calendar_next_week', 'յաջորդ')} &rarr;</a>
  </div>

  {blocks.length === 0 ? (
    <div class="empty-state">{L('calendar_empty_state', 'No workshop or cloud assigned yet.')}</div>
  ) : (
    <div class="grid-card">
      <div class="grid-outer">
        <div class="headers">
          <div></div>
          {weekDates.map((d, i) => (
            <div class="day-head">
              {WEEKDAY_SHORT[i]}
              <span class="date-num">{d.getDate()}</span>
            </div>
          ))}
        </div>
        <div class="grid-body" style={{ height: `${gridHeight}px` }}>
          <div class="hour-col">
            {hourMarks.map((m) => (
              <div class="mark" style={{ top: `${(m - bounds.startMin) * PX_PER_MIN}px` }}>{fmtHour(m)}</div>
            ))}
          </div>
          <div class="days-area">
            {hourMarks.map((m) => (
              <div class="hline" style={{ top: `${(m - bounds.startMin) * PX_PER_MIN}px` }}></div>
            ))}
            {enrichedBlocks.map((b) => (
              <a
                class={`block ${b.kind} ${b.cancelled ? 'cancelled' : ''}`}
                href={`/platform/library/${b.kind}/${b.sourceId}`}
                style={{
                  top: `${b.top}px`,
                  height: `${b.height}px`,
                  left: `calc(${b.dayIndex} * (100% / 7) + 2px)`,
                  width: `calc(100% / 7 - 4px)`,
                }}
                data-start={b.startIso}
                data-end={b.endIso}
              >
                <span>{b.label}</span>
                {b.cancelled && <span class="note">{b.overrideNote ?? L('calendar_cancelled', 'Cancelled')}</span>}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  )}
</div>

<style>
  .weeknav { display: flex; align-items: center; justify-content: center; gap: 1.25rem; margin-bottom: 1.5rem; }
  .weeknav a {
    color: #444;
    text-decoration: none;
    background: #fff;
    border: 1px solid #e9e9e4;
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .weeknav a:hover { background: #f6f6f4; }
  .weeknav .range { font-size: 0.95rem; font-weight: 700; }

  .empty-state {
    background: #fff;
    border: 1px solid #e9e9e4;
    border-radius: 14px;
    padding: 2.5rem 1.5rem;
    text-align: center;
    color: #888;
  }

  .grid-card { background: #fff; border: 1px solid #e9e9e4; border-radius: 14px; padding: 1.25rem; overflow-x: auto; }
  .grid-outer { min-width: 720px; }
  .headers { display: grid; grid-template-columns: 56px repeat(7, 1fr); margin-bottom: 0.5rem; }
  .headers .day-head { text-align: center; font-size: 0.8rem; font-weight: 700; }
  .headers .day-head .date-num { display: block; font-weight: 700; color: inherit; font-size: 1.1rem; margin-top: 0.2rem; }
  .grid-body { display: grid; grid-template-columns: 56px 1fr; position: relative; }
  .hour-col { position: relative; }
  .days-area {
    position: relative;
    background-image: repeating-linear-gradient(to right, rgba(0,0,0,0.06) 0, rgba(0,0,0,0.06) 1px, transparent 1px, transparent calc(100% / 7));
    border-top: 1px solid rgba(0,0,0,0.08);
  }
  .block {
    position: absolute;
    display: block;
    border-radius: 6px;
    padding: 0.25rem 0.4rem;
    font-size: 0.72rem;
    line-height: 1.25;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    cursor: pointer;
    transition: filter 0.15s;
  }
  .block:hover { filter: brightness(1.1); }
  .block.workshop { background: #6b5ce6; }
  .block.cloud { background: #2e9e4f; }
  .block.cancelled { background: rgba(0,0,0,0.15); color: rgba(0,0,0,0.5); text-decoration: line-through; }
  .block .note { text-decoration: none; display: block; font-style: italic; }
</style>

<style is:global>
  /* Astro's default scoped CSS only applies to server-rendered markup — it
     can't tag elements created later by client-side JS with the scoping
     attribute. The hour marks and gridlines are built in the <script>
     below, so their rules live here instead, namespaced under .pcal
     (unique to this component) to avoid bleeding into other pages'
     unrelated classes of the same name. */
  .pcal .hour-col .mark { position: absolute; left: 0; right: 4px; text-align: right; font-size: 0.7rem; color: #999; transform: translateY(-50%); }
  .pcal .hline { position: absolute; left: 0; right: 0; border-top: 1px solid rgba(0,0,0,0.06); }
</style>

<script>
  // The grid is rendered server-side in Paris time (hour axis + block
  // positions), because only the browser knows the viewer's own timezone.
  // Here we recompute the whole grid — hour marks, gridlines, and each
  // block's vertical position/height and displayed time — from the block's
  // real UTC instant, so everything lines up in the viewer's local time.
  // (Simplification: a block's day column stays the one it was scheduled on
  // in Paris time; only its time-of-day shifts. For sessions scheduled well
  // outside typical daytime hours in Paris, a viewer many hours ahead or
  // behind could see a session's local time cross midnight into the next/
  // previous day while it stays drawn under its original day column.)
  const PX_PER_MIN = 1;

  function fmtHour(min: number): string {
    const wrapped = ((min % (24 * 60)) + 24 * 60) % (24 * 60);
    const h = Math.floor(wrapped / 60);
    const m = wrapped % 60;
    return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
  }

  document.querySelectorAll<HTMLElement>('.pcal .grid-card').forEach((card) => {
    const gridBody = card.querySelector<HTMLElement>('.grid-body');
    const hourCol = card.querySelector<HTMLElement>('.hour-col');
    const daysArea = card.querySelector<HTMLElement>('.days-area');
    const blockEls = [...card.querySelectorAll<HTMLAnchorElement>('.block')];
    if (!gridBody || !hourCol || !daysArea || blockEls.length === 0) return;

    const localBlocks = blockEls.map((el) => {
      const start = new Date(el.dataset.start!);
      const end = new Date(el.dataset.end!);
      const startMin = start.getHours() * 60 + start.getMinutes();
      let endMin = end.getHours() * 60 + end.getMinutes();
      if (end.toDateString() !== start.toDateString()) endMin += 24 * 60;
      return { el, startMin, endMin };
    });

    const BUFFER = 30;
    const earliest = Math.min(...localBlocks.map((b) => b.startMin));
    const latest = Math.max(...localBlocks.map((b) => b.endMin));
    const boundsStart = Math.max(0, Math.floor((earliest - BUFFER) / 30) * 30);
    const boundsEnd = Math.min(24 * 60, Math.ceil((latest + BUFFER) / 30) * 30);

    gridBody.style.height = `${(boundsEnd - boundsStart) * PX_PER_MIN}px`;

    hourCol.innerHTML = '';
    daysArea.querySelectorAll('.hline').forEach((el) => el.remove());
    for (let m = Math.ceil(boundsStart / 60) * 60; m <= boundsEnd; m += 60) {
      const top = (m - boundsStart) * PX_PER_MIN;
      const mark = document.createElement('div');
      mark.className = 'mark';
      mark.style.top = `${top}px`;
      mark.textContent = fmtHour(m);
      hourCol.appendChild(mark);

      const hline = document.createElement('div');
      hline.className = 'hline';
      hline.style.top = `${top}px`;
      daysArea.insertBefore(hline, daysArea.firstChild);
    }

    for (const { el, startMin, endMin } of localBlocks) {
      el.style.top = `${(startMin - boundsStart) * PX_PER_MIN}px`;
      el.style.height = `${Math.max(20, (endMin - startMin) * PX_PER_MIN)}px`;
    }
  });
</script>
