---
import { adminGet } from '../lib/directusAdmin';
import {
  getWeekDates,
  buildSessionBlocks,
  buildMeetingBlocks,
  gridBounds,
  blockInstants,
  type SessionBlock,
  type WorkshopInfo,
  type CloudInfo,
} from '../lib/calendar';
import { CALENDAR_WEEKDAYS, MONTH_LABELS } from '../lib/minorFormContent';
import { getPlatformLabels, makeLabelGetter } from '../lib/platformLabels';
import { memberMeetingsBetween } from '../lib/zardipum';

interface Props {
  workshops: (WorkshopInfo | null)[];
  clouds: CloudInfo[];
  basePath?: string;
  // Member's registered timezone; the grid's script reads the same value
  // from <body data-tz>. Null keeps the browser's timezone.
  timezone?: string | null;
  // Shows the զարդիպումներ this member is invited to (all of them with allMeetings).
  memberId?: number;
  allMeetings?: boolean;
}

const { workshops, clouds, basePath = '/platform/calendar', timezone = null, memberId, allMeetings = false } = Astro.props;
const L = makeLabelGetter(await getPlatformLabels());

const requestedWeek = Astro.url.searchParams.get('week');
const anchor = requestedWeek && !Number.isNaN(Date.parse(requestedWeek)) ? new Date(requestedWeek) : new Date();
const weekDates = getWeekDates(anchor);
const weekStart = weekDates[0];
const weekEnd = weekDates[6];

function ymd(d: Date): string {
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}

const prevWeek = new Date(weekStart.getFullYear(), weekStart.getMonth(), weekStart.getDate() - 7);
const nextWeek = new Date(weekStart.getFullYear(), weekStart.getMonth(), weekStart.getDate() + 7);

let overrides: { date: string; note: string | null; workshop: number | null; cloud: number | null }[] = [];
try {
  const res = await adminGet(
    `/items/schedule_overrides?filter[active][_eq]=true&filter[date][_between]=${ymd(weekStart)},${ymd(weekEnd)}&fields=date,note,workshop,cloud&limit=-1`
  );
  overrides = res.data ?? [];
} catch (e) {
  console.error('Failed to load schedule overrides:', e);
}

const meetings = memberId ? await memberMeetingsBetween(memberId, ymd(weekStart), ymd(weekEnd), allMeetings) : [];
const blocks: SessionBlock[] = [...buildSessionBlocks(workshops, clouds, weekDates), ...buildMeetingBlocks(meetings, weekDates)].sort(
  (a, b) => a.date.getTime() - b.date.getTime() || a.startMin - b.startMin
);
const blockHref = (b: SessionBlock) =>
  b.kind === 'meeting' ? `/platform/facilitator#zardipum-${b.sourceId}` : `/platform/library/${b.kind}/${b.sourceId}`;
// Small round thumbnail of the workshop/cloud image (Directus resizes it);
// the library's lamp/cloud pictures stand in for groups without one, and
// every cancelled session (meetings too) shows the «տէրս երես» picture.
const DIRECTUS_URL = import.meta.env.DIRECTUS_URL;
const blockImage = (b: SessionBlock & { cancelled?: boolean }): string | null =>
  b.cancelled
    ? '/ters_yeres-small.png'
    : b.kind === 'meeting'
    ? null
    : b.image
      ? `${DIRECTUS_URL}/assets/${b.image}?width=128&height=128&fit=cover`
      : b.kind === 'workshop'
        ? '/lamp.png'
        : '/cloud.png';
const bounds = gridBounds(blocks);
const PX_PER_MIN = 2;
const gridHeight = (bounds.endMin - bounds.startMin) * PX_PER_MIN;

const hourMarks: number[] = [];
for (let m = Math.ceil(bounds.startMin / 60) * 60; m <= bounds.endMin; m += 60) hourMarks.push(m);

function fmtHour(min: number): string {
  return `${String(Math.floor(min / 60)).padStart(2, '0')}:${String(min % 60).padStart(2, '0')}`;
}

// Monday-first, matching getWeekDates()'s order.
const WEEKDAY_SHORT = CALENDAR_WEEKDAYS.hyw;
const MONTH_SHORT = MONTH_LABELS.hyw;

const enrichedBlocks = blocks.map((b) => {
  const dateStr = ymd(b.date);
  const override = overrides.find(
    (o) => o.date === dateStr && (b.kind === 'workshop' ? o.workshop === b.sourceId : o.cloud === b.sourceId)
  );
  const dayIndex = Math.round((b.date.getTime() - weekStart.getTime()) / (24 * 60 * 60 * 1000));
  const { start, end } = blockInstants(b);
  return {
    ...b,
    dayIndex,
    cancelled: b.kind === 'meeting' ? !!b.cancelled : !!override,
    overrideNote: b.kind === 'meeting' ? (b.cancelled ? L('meeting_cancelled', 'Ջնջուած է։') : null) : override?.note ?? null,
    top: (b.startMin - bounds.startMin) * PX_PER_MIN,
    height: Math.max(20, (b.endMin - b.startMin) * PX_PER_MIN),
    startIso: start.toISOString(),
    endIso: end.toISOString(),
  };
});

// Phones get a day-by-day list instead of the 7-column grid, which can't fit
// on a narrow screen. Grouped under the day each session is scheduled on in
// Paris, same as the grid's columns.
const WEEKDAY_FULL = ['Երկուշաբթի', 'Երեքշաբթի', 'Չորեքշաբթի', 'Հինգշաբթի', 'Ուրբաթ', 'Շաբաթ', 'Կիրակի'];
const agendaDays = weekDates
  .map((d, i) => ({
    label: `${WEEKDAY_FULL[i]}, ${MONTH_SHORT[d.getMonth()]} ${d.getDate()}`,
    blocks: enrichedBlocks.filter((b) => b.dayIndex === i),
  }))
  .filter((day) => day.blocks.length > 0);
---

<div class="pcal">
  <div class="weeknav">
    <a href={`${basePath}?week=${ymd(prevWeek)}`} aria-label={L('calendar_prev_week', 'նախորդ')}>&larr;<span class="lbl"> {L('calendar_prev_week', 'նախորդ')}</span></a>
    <span class="range">
      {MONTH_SHORT[weekStart.getMonth()]} {weekStart.getDate()} – {MONTH_SHORT[weekEnd.getMonth()]} {weekEnd.getDate()}
    </span>
    <a href={`${basePath}?week=${ymd(nextWeek)}`} aria-label={L('calendar_next_week', 'յաջորդ')}><span class="lbl">{L('calendar_next_week', 'յաջորդ')} </span>&rarr;</a>
  </div>

  {blocks.length === 0 ? (
    <div class="empty-state">{L('calendar_empty_state', 'No workshop or cloud assigned yet.')}</div>
  ) : (
    <>
    <div class="grid-card">
      <div class="grid-outer">
        <div class="headers">
          <div></div>
          {weekDates.map((d, i) => (
            <div class="day-head">
              {WEEKDAY_SHORT[i]}
              <span class="date-num">{d.getDate()}</span>
            </div>
          ))}
        </div>
        <div class="grid-body" style={{ height: `${gridHeight}px` }}>
          <div class="hour-col">
            {hourMarks.map((m) => (
              <div class="mark" style={{ top: `${(m - bounds.startMin) * PX_PER_MIN}px` }}>{fmtHour(m)}</div>
            ))}
          </div>
          <div class="days-area">
            {hourMarks.map((m) => (
              <div class="hline" style={{ top: `${(m - bounds.startMin) * PX_PER_MIN}px` }}></div>
            ))}
            {enrichedBlocks.map((b) => (
              <a
                class={`block ${b.kind} ${b.cancelled ? 'cancelled' : ''} ${b.endMin - b.startMin < 30 ? 'short' : ''}`}
                href={b.cancelled ? undefined : blockHref(b)}
                style={{
                  top: `${b.top}px`,
                  height: `${b.height}px`,
                  left: `calc(${b.dayIndex} * (100% / 7) + 2px)`,
                  width: `calc(100% / 7 - 4px)`,
                }}
                data-start={b.startIso}
                data-end={b.endIso}
                data-day={b.dayIndex}
              >
                <span class="block-title">
                  {blockImage(b) && <img class={`thumb ${b.cancelled ? 'cancelled-pic' : ''}`} src={blockImage(b)!} alt="" loading="lazy" />}
                  <span>{b.label}</span>
                </span>
                {b.cancelled && <span class="note">{b.overrideNote ?? L('calendar_cancelled', 'Cancelled')}</span>}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
    <div class="agenda">
      {agendaDays.map((day) => (
        <div class="agenda-day">
          <div class="agenda-date">{day.label}</div>
          {day.blocks.map((b) => (
            <a
              class={`agenda-item ${b.kind} ${b.cancelled ? 'cancelled' : ''}`}
              href={b.cancelled ? undefined : blockHref(b)}
              data-start={b.startIso}
              data-end={b.endIso}
            >
              <span class="agenda-time">{fmtHour(b.startMin)}–{fmtHour(b.endMin)}</span>
              {blockImage(b) && <img class={`thumb ${b.cancelled ? 'cancelled-pic' : ''}`} src={blockImage(b)!} alt="" loading="lazy" />}
              <span class="agenda-label">
                {b.label}
                {b.cancelled && <span class="note">{b.overrideNote ?? L('calendar_cancelled', 'Cancelled')}</span>}
              </span>
            </a>
          ))}
        </div>
      ))}
    </div>
    </>
  )}
  {timezone && blocks.length > 0 && (
    <div class="tz-note">{L('calendar_timezone_note', 'Ժամանակացոյցը կը ցուցադրուի ըստ ձեր արձանագրած տեղական ժամերու գօտիին։')}</div>
  )}
</div>

<style>
  .weeknav { display: flex; align-items: center; justify-content: center; gap: 1.25rem; margin-bottom: 1.5rem; }
  .weeknav a {
    color: #444;
    text-decoration: none;
    background: #fff;
    border: 1px solid #e9e9e4;
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .weeknav a:hover { background: #f7f4ee; }
  .weeknav .range { font-size: 0.95rem; font-weight: 700; }

  .agenda { display: none; }
  .agenda-day { margin-bottom: 1.1rem; }
  .agenda-date { font-size: 0.8rem; font-weight: 700; color: #797970; margin-bottom: 0.45rem; }
  .agenda-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background: #fff;
    border: 1px solid #e9e9e4;
    border-left: 4px solid;
    border-radius: 10px;
    padding: 0.75rem 0.9rem;
    margin-bottom: 0.5rem;
    color: inherit;
    text-decoration: none;
  }
  .agenda-item.workshop { border-left-color: #6b5ce6; }
  .agenda-item.cloud { border-left-color: #2e9e4f; }
  .agenda-item.meeting { border-left-color: #e8a33d; }
  .agenda-item.cancelled { opacity: 0.55; }
  .agenda-time { font-size: 0.85rem; font-weight: 700; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .agenda-label { font-size: 0.9rem; font-weight: 600; min-width: 0; }
  .agenda-label .note { display: block; font-size: 0.78rem; font-weight: 400; font-style: italic; color: #797970; text-decoration: none; }

  @media (max-width: 640px) {
    .grid-card { display: none; }
    .agenda { display: block; }
    .weeknav { justify-content: space-between; gap: 0.5rem; margin-bottom: 1.25rem; }
    .weeknav .lbl { display: none; }
    .weeknav a {
      width: 2.5rem;
      height: 2.5rem;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.05rem;
      flex-shrink: 0;
    }
    .weeknav .range { font-size: 0.9rem; text-align: center; }
  }

  .empty-state {
    background: #fff;
    border: 1px solid #e9e9e4;
    border-radius: 14px;
    padding: 2.5rem 1.5rem;
    text-align: center;
    color: #888;
  }

  .grid-card { background: #fff; border: 1px solid #e9e9e4; border-radius: 14px; padding: 1.25rem; overflow-x: auto; }
  .grid-outer { min-width: 720px; }
  .headers { display: grid; grid-template-columns: 56px repeat(7, 1fr); margin-bottom: 0.5rem; }
  .headers .day-head { text-align: center; font-size: 0.8rem; font-weight: 700; }
  .headers .day-head .date-num { display: block; font-weight: 700; color: inherit; font-size: 1.1rem; margin-top: 0.2rem; }
  .grid-body { display: grid; grid-template-columns: 56px 1fr; position: relative; }
  .hour-col { position: relative; }
  .days-area {
    position: relative;
    background-image: repeating-linear-gradient(to right, rgba(0,0,0,0.06) 0, rgba(0,0,0,0.06) 1px, transparent 1px, transparent calc(100% / 7));
    border-top: 1px solid rgba(0,0,0,0.08);
  }
  .block {
    position: absolute;
    display: flex;
    flex-direction: column;
    /* "safe": a block too short for its content starts at the top (image
       visible) instead of being cut on both ends. */
    justify-content: safe center;
    align-items: center;
    text-align: center;
    border-radius: 6px;
    padding: 0.25rem 0.4rem;
    font-size: 0.72rem;
    line-height: 1.25;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    cursor: pointer;
    transition: filter 0.15s;
  }
  .block:hover { filter: brightness(1.1); }
  /* Cancelled sessions carry no link: no hand cursor, no hover. */
  .block.cancelled { cursor: default; }
  .block.cancelled:hover { filter: none; }
  .block.workshop { background: #6b5ce6; }
  .block.cloud { background: #2e9e4f; }
  .block.meeting { background: #b5651d; }
  .block.cancelled { background: rgba(0,0,0,0.15); color: rgba(0,0,0,0.5); }
  .block .note { text-decoration: none; display: block; font-style: italic; }
  /* Image above the name, so the name keeps the full column width. */
  .block-title { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; }
  .thumb { flex-shrink: 0; width: 48px; height: 48px; border-radius: 50%; object-fit: cover; background: #fff; border: 1.5px solid rgba(255,255,255,0.85); }
  /* Sessions under half an hour are too short for both: image beside the name. */
  .block.short .block-title { flex-direction: row; align-items: center; gap: 0.3rem; }
  .block.short .thumb { width: 26px; height: 26px; }
  .agenda-item .thumb { width: 52px; height: 52px; align-self: center; border-color: #e9e9e4; }
  /* The «տէրս երես» picture of a cancelled session: whole, not in a circle. */
  .thumb.cancelled-pic { width: auto; border: none; border-radius: 0; background: none; object-fit: contain; }
</style>

<style is:global>
  /* Astro's default scoped CSS only applies to server-rendered markup — it
     can't tag elements created later by client-side JS with the scoping
     attribute. The hour marks and gridlines are built by the client script
     below, so their rules live here instead, namespaced under .pcal
     (unique to this component) to avoid bleeding into other pages'
     unrelated classes of the same name. */
  .pcal .hour-col .mark { position: absolute; left: 0; right: 4px; text-align: right; font-size: 0.7rem; color: #999; transform: translateY(-50%); }
  .pcal .hline { position: absolute; left: 0; right: 0; border-top: 1px solid rgba(0,0,0,0.06); }

  /* The app-wide box-sizing reset (PlatformLayout.astro) is itself scoped
     and never reaches this component's elements, so .block's padding was
     adding to its JS-set height instead of being included in it — each
     session block rendered taller than the grid math intended. */
  .pcal .block { box-sizing: border-box; }
  .pcal .tz-note { font-size: 0.75rem; color: #888; text-align: center; margin-top: 0.75rem; }
</style>

<script>
  // The grid is rendered server-side in Paris time (hour axis + block
  // positions), then redrawn here in the member's registered timezone
  // (<body data-tz>), or the browser's own when none is on file.
  // Here we recompute the whole grid — hour marks, gridlines, and each
  // block's vertical position/height and displayed time — from the block's
  // real UTC instant, so everything lines up in the viewer's local time.
  // (Simplification: a block's day column stays the one it was scheduled on
  // in Paris time; only its time-of-day shifts. For sessions scheduled well
  // outside typical daytime hours in Paris, a viewer many hours ahead or
  // behind could see a session's local time cross midnight into the next/
  // previous day while it stays drawn under its original day column.)
  const PX_PER_MIN = 2;

  let tz: string | undefined = document.body.dataset.tz || undefined;
  let formatter: Intl.DateTimeFormat;
  const FORMAT_OPTIONS: Intl.DateTimeFormatOptions = {
    year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
  };
  try {
    formatter = new Intl.DateTimeFormat('en-US', { ...FORMAT_OPTIONS, timeZone: tz });
  } catch {
    tz = undefined;
    formatter = new Intl.DateTimeFormat('en-US', FORMAT_OPTIONS);
  }

  // Wall-clock date + minutes-since-midnight of an instant in that timezone.
  function wallTime(d: Date): { day: string; min: number } {
    const p: Record<string, string> = {};
    for (const part of formatter.formatToParts(d)) p[part.type] = part.value;
    return { day: `${p.year}-${p.month}-${p.day}`, min: Number(p.hour) * 60 + Number(p.minute) };
  }

  function fmtHour(min: number): string {
    const wrapped = ((min % (24 * 60)) + 24 * 60) % (24 * 60);
    const h = Math.floor(wrapped / 60);
    const m = wrapped % 60;
    return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
  }

  // Phone list view: rewrite each session's time in the same timezone.
  document.querySelectorAll<HTMLElement>('.pcal .agenda-item').forEach((el) => {
    const timeEl = el.querySelector<HTMLElement>('.agenda-time');
    if (!timeEl) return;
    const start = wallTime(new Date(el.dataset.start!));
    const end = wallTime(new Date(el.dataset.end!));
    timeEl.textContent = `${fmtHour(start.min)}–${fmtHour(end.min)}`;
  });

  document.querySelectorAll<HTMLElement>('.pcal .grid-card').forEach((card) => {
    const gridBody = card.querySelector<HTMLElement>('.grid-body');
    const hourCol = card.querySelector<HTMLElement>('.hour-col');
    const daysArea = card.querySelector<HTMLElement>('.days-area');
    const blockEls = [...card.querySelectorAll<HTMLAnchorElement>('.block')];
    if (!gridBody || !hourCol || !daysArea || blockEls.length === 0) return;

    const localBlocks = blockEls.map((el) => {
      const start = wallTime(new Date(el.dataset.start!));
      const end = wallTime(new Date(el.dataset.end!));
      const startMin = start.min;
      let endMin = end.min;
      if (end.day !== start.day) endMin += 24 * 60;
      return { el, startMin, endMin };
    });

    const BUFFER = 10;
    const earliest = Math.min(...localBlocks.map((b) => b.startMin));
    const latest = Math.max(...localBlocks.map((b) => b.endMin));
    const boundsStart = Math.max(0, Math.floor((earliest - BUFFER) / 30) * 30);
    const boundsEnd = Math.min(24 * 60, Math.ceil((latest + BUFFER) / 30) * 30);

    gridBody.style.height = `${(boundsEnd - boundsStart) * PX_PER_MIN}px`;

    hourCol.innerHTML = '';
    daysArea.querySelectorAll('.hline').forEach((el) => el.remove());
    for (let m = Math.ceil(boundsStart / 60) * 60; m <= boundsEnd; m += 60) {
      const top = (m - boundsStart) * PX_PER_MIN;
      const mark = document.createElement('div');
      mark.className = 'mark';
      mark.style.top = `${top}px`;
      mark.textContent = fmtHour(m);
      hourCol.appendChild(mark);

      const hline = document.createElement('div');
      hline.className = 'hline';
      hline.style.top = `${top}px`;
      daysArea.insertBefore(hline, daysArea.firstChild);
    }

    for (const { el, startMin, endMin } of localBlocks) {
      el.style.top = `${(startMin - boundsStart) * PX_PER_MIN}px`;
      el.style.height = `${Math.max(20, (endMin - startMin) * PX_PER_MIN)}px`;
    }

    // Sessions that overlap on the same day sit side by side (each group of
    // overlapping sessions shares its day column equally) instead of on top
    // of each other.
    const byDay = new Map<string, typeof localBlocks>();
    for (const b of localBlocks) {
      const day = b.el.dataset.day ?? '0';
      byDay.set(day, [...(byDay.get(day) ?? []), b]);
    }
    for (const [day, blocks] of byDay) {
      blocks.sort((a, b) => a.startMin - b.startMin || b.endMin - a.endMin);
      let cluster: Array<{ b: (typeof blocks)[number]; col: number }> = [];
      let clusterEnd = -1;
      const place = () => {
        const cols = Math.max(1, ...cluster.map((c) => c.col + 1));
        for (const { b, col } of cluster) {
          b.el.style.width = `calc((100% / 7 - 4px) / ${cols} - ${cols > 1 ? 2 : 0}px)`;
          b.el.style.left = `calc(${day} * (100% / 7) + 2px + (100% / 7 - 4px) * ${col} / ${cols})`;
        }
      };
      for (const b of blocks) {
        if (b.startMin >= clusterEnd && cluster.length) {
          place();
          cluster = [];
          clusterEnd = -1;
        }
        // first column whose last session has ended
        let col = 0;
        while (cluster.some((c) => c.col === col && c.b.endMin > b.startMin)) col++;
        cluster.push({ b, col });
        clusterEnd = Math.max(clusterEnd, b.endMin);
      }
      if (cluster.length) place();
    }
  });
</script>
