---
import { getPlatformLabels, makeLabelGetter } from '../../lib/platformLabels';
const L = makeLabelGetter(await getPlatformLabels());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zartsants Platform — Sign In</title>
    <style>
      /* Same palette and chrome as PlatformLayout, so signing in looks like
         the platform it leads to. */
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        background: #f7f4ee;
        font-family: system-ui, sans-serif;
        color: #1a1a1a;
      }
      main {
        flex: 1;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
      }
      .brand img { height: 100px; width: auto; display: block; margin-bottom: 1.5rem; }
      .card {
        width: 100%;
        max-width: 380px;
        padding: 2.5rem;
        background: #fff;
        border: 1px solid #ebe7df;
        border-radius: 12px;
      }
      h1 { font-size: 1.5rem; margin-bottom: 2rem; font-weight: 600; }
      label { display: block; font-size: 0.8rem; font-weight: 600; color: #555; margin-bottom: 0.4rem; }
      input {
        width: 100%;
        padding: 0.75rem 1rem;
        background: #fff;
        border: 1px solid #dcdcd6;
        border-radius: 8px;
        color: #1a1a1a;
        font-size: 1rem;
        margin-bottom: 1.2rem;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
      }
      input:focus { border-color: #9683fe; box-shadow: 0 0 0 3px rgba(150, 131, 254, 0.2); }
      button {
        width: 100%;
        padding: 0.8rem;
        background: #9683fe;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s;
      }
      button:hover { opacity: 0.85; }
      button:disabled { opacity: 0.6; cursor: default; }
      .error { color: #c0392b; font-size: 0.875rem; margin-bottom: 1rem; display: none; }
      .error.visible { display: block; }
      .site-footer {
        width: 100%;
        padding: 1.5rem 1.5rem 2rem;
        border-top: 1px solid #ebe7df;
        display: flex;
        justify-content: center;
      }
      .site-footer img { height: 36px; width: auto; opacity: 0.85; }

      @media (max-width: 640px) {
        .brand img { height: 64px; }
        .card { padding: 1.75rem 1.5rem; }
      }
    </style>
  </head>
  <body>
    <main>
    <div class="brand"><img src="/zartsants-logo.svg" alt="Zartsants" /></div>
    <div class="card">
      <h1>{L('login_title', 'Sign In')}</h1>
      <p class="error" id="error">{L('login_error_invalid', 'Invalid username or password.')}</p>
      <form id="login-form">
        <label for="username">{L('login_username_label', 'Username')}</label>
        <input id="username" name="username" type="text" required autocomplete="username" />
        <label for="password">{L('login_password_label', 'Password')}</label>
        <input id="password" name="password" type="password" required autocomplete="current-password" />
        <button type="submit" id="submit-btn">{L('login_continue_button', 'Continue')}</button>
      </form>
    </div>
    </main>
    <footer class="site-footer">
      <img src="/gulbenkian-logo.png" alt="Gulbenkian" />
    </footer>

    <script is:inline define:vars={{
      errorInvalid: L('login_error_invalid', 'Invalid username or password.'),
      errorGeneric: L('login_error_generic', 'Something went wrong. Please try again.'),
      loadingText: L('login_loading', '...'),
      continueText: L('login_continue_button', 'Continue'),
    }}>
      const form = document.getElementById('login-form');
      const errorEl = document.getElementById('error');
      const submitBtn = document.getElementById('submit-btn');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.classList.remove('visible');
        submitBtn.disabled = true;
        submitBtn.textContent = loadingText;

        const username = document.getElementById('username').value;
        const password = document.getElementById('password').value;

        try {
          const res = await fetch('/api/platform/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password }),
          });
          if (res.ok) {
            window.location.href = '/platform';
          } else {
            const data = await res.json().catch(() => ({}));
            errorEl.textContent = data.error ?? errorInvalid;
            errorEl.classList.add('visible');
          }
        } catch {
          errorEl.textContent = errorGeneric;
          errorEl.classList.add('visible');
        }

        submitBtn.disabled = false;
        submitBtn.textContent = continueText;
      });
    </script>
  </body>
</html>
