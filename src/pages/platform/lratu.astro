---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import { requireMember } from '../../lib/platformAuth';
import { getPlatformLabels, makeLabelGetter } from '../../lib/platformLabels';

const member = await requireMember(Astro.request);
if (!member) {
  return Astro.redirect('/platform/login');
}
const L = makeLabelGetter(await getPlatformLabels());
---

<PlatformLayout title="Zartsants Platform — Լրատու" member={member}>
  <style>
    .container { max-width: 700px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
    .back { display: inline-block; color: #666; text-decoration: none; font-size: 0.85rem; margin-bottom: 1rem; }
    .back:hover { text-decoration: underline; }

    .empty-state {
      background: #fff;
      border: 1px solid #e9e9e4;
      border-radius: 14px;
      padding: 2.5rem 1.5rem;
      text-align: center;
    }
    .empty-state svg { width: 70px; height: 70px; color: #4a3fcf; display: block; margin: 0 auto 1rem; }
    .empty-state p { color: #888; }
  </style>

  <div class="container">
    <a class="back" href="/platform">&larr; {L('admin_back_to_dashboard', 'Dashboard')}</a>
    <div class="empty-state">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <rect x="3" y="4" width="14" height="16" rx="1" />
        <path d="M7 8h6M7 12h6M7 16h4" />
        <path d="M17 8h3a1 1 0 0 1 1 1v9a2 2 0 0 1-2 2H7" />
      </svg>
      <p>{L('coming_soon', 'Coming soon.')}</p>
    </div>
  </div>
</PlatformLayout>
