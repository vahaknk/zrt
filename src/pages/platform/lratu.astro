---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import { requireMember, memberTimezone } from '../../lib/platformAuth';
import { newsFor } from '../../lib/publishing';
import { formatDateTime } from '../../lib/submissions';
import { MONTH_LABELS } from '../../lib/minorFormContent';
import { getPlatformLabels, makeLabelGetter } from '../../lib/platformLabels';

// «Լրատու»: the team's news posts meant for this member, newest first.
const member = await requireMember(Astro.request);
if (!member) {
  return Astro.redirect('/platform/login?next=/platform/lratu');
}
const L = makeLabelGetter(await getPlatformLabels());
const posts = await newsFor(member);
const tz = memberTimezone(member);
const date = (iso: string) => formatDateTime(iso, tz, MONTH_LABELS.hyw).split(',')[0];
const size = (bytes: string | null) => {
  const n = Number(bytes ?? 0);
  return n >= 1048576 ? `${Math.round(n / 1048576)} MB` : `${Math.max(1, Math.round(n / 1024))} KB`;
};
---

<PlatformLayout title="Zartsants Platform — Լրատու" member={member}>
  <style>
    .container { max-width: 760px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
    @media (max-width: 640px) { .container { padding: 1.5rem 1rem 2.5rem; } }
    .back { display: inline-block; color: #666; text-decoration: none; font-size: 0.85rem; margin-bottom: 1rem; }
    .back:hover { text-decoration: underline; }
    h1 { font-size: 1.35rem; font-weight: 700; margin-bottom: 1.25rem; }
    .posts { display: flex; flex-direction: column; gap: 1.25rem; }
    .post { background: #fff; border: 1px solid #e9e9e4; border-radius: 14px; overflow: hidden; scroll-margin-top: 5rem; }
    .post:target { box-shadow: 0 0 0 2px #7a63f5; }
    .post img { display: block; width: 100%; max-height: 420px; object-fit: cover; background: #efeae0; }
    .post-body { padding: 1.1rem 1.4rem 1.3rem; }
    .post h2 { font-size: 1.1rem; font-weight: 700; }
    .meta { font-size: 0.78rem; color: #9a9a94; margin-top: 0.2rem; }
    .text { font-size: 0.95rem; line-height: 1.65; white-space: pre-wrap; word-break: break-word; margin-top: 0.7rem; }
    .attach { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.9rem; background: #f7f4ee; border-radius: 10px; padding: 0.5rem 0.85rem; color: #4a3fcf; font-size: 0.88rem; text-decoration: none; }
    .attach:hover { background: #efeae0; }
    .empty-state { background: #fff; border: 1px solid #e9e9e4; border-radius: 14px; padding: 2.5rem 1.5rem; text-align: center; }
    .empty-state img { width: 70px; height: 70px; object-fit: contain; display: block; margin: 0 auto 1rem; }
    .empty-state p { color: #888; }
  </style>

  <div class="container">
    <a class="back" href="/platform">&larr; {L('admin_back_to_dashboard', 'Dashboard')}</a>
    <h1>{L('dashboard_tile_lratu', 'Լրատու')}</h1>

    {posts.length === 0 ? (
      <div class="empty-state">
        <img src="/megaphone.png" alt="" />
        <p>{L('lratu_empty', 'Տակաւին լուր չկայ։')}</p>
      </div>
    ) : (
      <div class="posts">
        {posts.map((p) => (
          <article class="post" id={`news-${p.id}`}>
            {p.image && <img src={`/api/platform/news/${p.id}/image`} alt="" loading="lazy" />}
            <div class="post-body">
              <h2>{p.title}</h2>
              <div class="meta">
                {date(p.date_created)}
                {p.audience === 'group' && (p.workshop || p.cloud) && <> · {p.workshop?.name ?? p.cloud?.name}</>}
              </div>
              {p.body && <div class="text">{p.body}</div>}
              {p.attachment && (
                <a class="attach" href={`/api/platform/news/${p.id}/attachment`}>📎 {p.attachment.filename_download} · {size(p.attachment.filesize)}</a>
              )}
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</PlatformLayout>
