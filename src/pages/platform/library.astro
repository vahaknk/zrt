---
import { requireMember } from '../../lib/platformAuth';
import { adminGet } from '../../lib/directusAdmin';
import { getWeekDates } from '../../lib/calendar';
import { MONTH_LABELS } from '../../lib/minorFormContent';

const member = await requireMember(Astro.request);
if (!member) {
  return Astro.redirect('/platform/login');
}

const requestedWeek = Astro.url.searchParams.get('week');
const anchor = requestedWeek && !Number.isNaN(Date.parse(requestedWeek)) ? new Date(requestedWeek) : new Date();
const weekDates = getWeekDates(anchor);
const weekStart = weekDates[0];
const weekEnd = weekDates[6];

function ymd(d: Date): string {
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}

const prevWeek = new Date(weekStart.getFullYear(), weekStart.getMonth(), weekStart.getDate() - 7);
const nextWeek = new Date(weekStart.getFullYear(), weekStart.getMonth(), weekStart.getDate() + 7);

const workshopId = member.workshop?.id ?? null;
const cloudIds = member.clouds.map((c) => c.clouds_id.id);

interface Material {
  id: number;
  type: 'video' | 'audio' | 'reading';
  label: string;
  url: string;
}

let materials: Material[] = [];
if (workshopId || cloudIds.length > 0) {
  const sourceOr = [];
  if (workshopId) sourceOr.push({ workshop: { _eq: workshopId } });
  if (cloudIds.length > 0) sourceOr.push({ cloud: { _in: cloudIds } });
  const filter = { _and: [{ week_start: { _eq: ymd(weekStart) } }, { _or: sourceOr }] };

  try {
    const res = await adminGet(
      `/items/materials?filter=${encodeURIComponent(JSON.stringify(filter))}&sort=sort,label&fields=id,type,label,url&limit=-1`
    );
    materials = res.data ?? [];
  } catch (e) {
    console.error('Failed to load materials:', e);
  }
}

const MONTH_SHORT = MONTH_LABELS.hyw;

const SECTIONS: { type: Material['type']; label: string }[] = [
  { type: 'video', label: 'Video' },
  { type: 'audio', label: 'Audio' },
  { type: 'reading', label: 'Reading' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zartsants Platform — Library</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        min-height: 100vh;
        background: #9683fe;
        font-family: system-ui, sans-serif;
        color: #000;
      }
      .page { padding: 2rem clamp(1.5rem, 6vw, 5rem); }
      a.back { color: #000; text-decoration: none; opacity: 0.7; font-size: 0.9rem; }
      h1 { font-size: 1.6rem; font-weight: 700; margin: 1rem 0 1.5rem; }
      .nav { display: flex; align-items: center; justify-content: center; gap: 1.5rem; margin-bottom: 1.5rem; font-weight: 600; }
      .nav a { color: #000; text-decoration: none; background: #fff; border-radius: 999px; padding: 0.4rem 0.9rem; font-size: 0.85rem; }
      .nav .range { font-size: 1rem; }
      .empty-state { background: #fff; border-radius: 12px; padding: 2rem; text-align: center; opacity: 0.7; max-width: 480px; margin: 0 auto; }
      .sections { max-width: 560px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.25rem; }
      .section { background: #fff; border-radius: 12px; padding: 1.25rem 1.5rem; }
      .section h2 { font-size: 1rem; font-weight: 700; margin-bottom: 0.75rem; }
      .section ul { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
      .section a { color: #6b5ce6; text-decoration: none; font-size: 0.95rem; }
      .section a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <div class="page">
    <a class="back" href="/platform">&larr; Back</a>
    <h1>Library</h1>

    <div class="nav">
      <a href={`/platform/library?week=${ymd(prevWeek)}`}>&larr; նախորդ</a>
      <span class="range">
        {MONTH_SHORT[weekStart.getMonth()]} {weekStart.getDate()} – {MONTH_SHORT[weekEnd.getMonth()]} {weekEnd.getDate()}
      </span>
      <a href={`/platform/library?week=${ymd(nextWeek)}`}>յաջորդ &rarr;</a>
    </div>

    {!workshopId && cloudIds.length === 0 ? (
      <div class="empty-state">No workshop or cloud assigned yet.</div>
    ) : materials.length === 0 ? (
      <div class="empty-state">No materials shared for this week yet.</div>
    ) : (
      <div class="sections">
        {SECTIONS.map((s) => {
          const items = materials.filter((m) => m.type === s.type);
          if (items.length === 0) return null;
          return (
            <div class="section">
              <h2>{s.label}</h2>
              <ul>
                {items.map((m) => (
                  <li><a href={m.url} target="_blank" rel="noopener">{m.label}</a></li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
    )}
    </div>
  </body>
</html>
