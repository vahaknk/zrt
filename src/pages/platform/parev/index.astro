---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import FileStage from '../../../components/FileStage.astro';
import { requireMember, memberTimezone } from '../../../lib/platformAuth';
import { publishedVideos } from '../../../lib/publishing';
import { formatDateTime } from '../../../lib/submissions';
import { MONTH_LABELS } from '../../../lib/minorFormContent';
import { getPlatformLabels, makeLabelGetter } from '../../../lib/platformLabels';

// «Բարեւ»: the team's videos for everyone — the newest one large, earlier ones below.
const member = await requireMember(Astro.request);
if (!member) {
  return Astro.redirect('/platform/login?next=/platform/parev');
}
const L = makeLabelGetter(await getPlatformLabels());
const videos = (await publishedVideos()).filter((v) => v.platform_file);
const [latest, ...earlier] = videos;
const tz = memberTimezone(member);
const date = (iso: string) => formatDateTime(iso, tz, MONTH_LABELS.hyw).split(',')[0];
---

<PlatformLayout title="Zartsants Platform — Բարեւ" member={member}>
  <style>
    .container { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
    @media (max-width: 640px) { .container { padding: 1.5rem 1rem 2.5rem; } }
    .back { display: inline-block; color: #666; text-decoration: none; font-size: 0.85rem; margin-bottom: 1rem; }
    .back:hover { text-decoration: underline; }
    h1 { font-size: 1.35rem; font-weight: 700; margin-bottom: 1.25rem; }
    .latest h2 { font-size: 1.15rem; font-weight: 700; margin: 1rem 0 0.25rem; }
    .meta { font-size: 0.8rem; color: #9a9a94; }
    .desc { font-size: 0.95rem; line-height: 1.6; white-space: pre-wrap; margin-top: 0.6rem; }
    .earlier { margin-top: 2.5rem; }
    .earlier h3 { font-size: 1rem; font-weight: 700; margin-bottom: 0.9rem; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; }
    .card { display: block; text-decoration: none; color: inherit; background: #fff; border: 1px solid #e9e9e4; border-radius: 12px; overflow: hidden; }
    .card:hover { border-color: #cfc6ff; }
    .card .thumb { aspect-ratio: 16 / 9; background: #efeae0 center / cover no-repeat; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; }
    .card .t { padding: 0.6rem 0.8rem 0.2rem; font-size: 0.9rem; font-weight: 700; }
    .card .meta { padding: 0 0.8rem 0.7rem; }
    .empty-state { background: #fff; border: 1px solid #e9e9e4; border-radius: 14px; padding: 2.5rem 1.5rem; text-align: center; }
    .empty-state img { height: 140px; width: auto; display: block; margin: 0 auto 1rem; }
    .empty-state p { color: #888; }
  </style>

  <div class="container">
    <a class="back" href="/platform">&larr; {L('admin_back_to_dashboard', 'Dashboard')}</a>
    <h1>{L('dashboard_tile_parev', 'Բարե՛ւ')}</h1>

    {!latest ? (
      <div class="empty-state">
        <img src="/platform_parev.png" alt="" />
        <p>{L('parev_empty', 'Շուտով առաջին տեսերիզը։')}</p>
      </div>
    ) : (
      <>
        <section class="latest">
          <FileStage file={latest.platform_file!} title={latest.title} canDownload={false} />
          <h2>{latest.title}</h2>
          <div class="meta">{date(latest.date_created)}</div>
          {latest.description && <p class="desc">{latest.description}</p>}
        </section>

        {earlier.length > 0 && (
          <section class="earlier">
            <h3>{L('parev_earlier', 'Նախորդ տեսերիզները')}</h3>
            <div class="grid">
              {earlier.map((v) => (
                <a class="card" href={`/platform/parev/${v.id}`}>
                  <div class="thumb" style={v.platform_file?.thumb_key ? `background-image: url('/api/platform/files/${v.platform_file.id}?thumb=1')` : undefined}>
                    {!v.platform_file?.thumb_key && '▶'}
                  </div>
                  <div class="t">{v.title}</div>
                  <div class="meta">{date(v.date_created)}</div>
                </a>
              ))}
            </div>
          </section>
        )}
      </>
    )}
  </div>
</PlatformLayout>
