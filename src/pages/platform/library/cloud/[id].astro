---
import PlatformLayout from '../../../../layouts/PlatformLayout.astro';
import { requireMember, displayName, isWebUrl, memberTimezone } from '../../../../lib/platformAuth';
import SubmissionComposer from '../../../../components/SubmissionComposer.astro';
import SubmissionList from '../../../../components/SubmissionList.astro';
import { enrolledInGroup, facilitatesGroup, ownSubmissions } from '../../../../lib/submissions';
import { viewsFor, percentReached, materialApproved } from '../../../../lib/materialViews';
import { adminGet } from '../../../../lib/directusAdmin';
import { formatScheduleLabel, parseDays, scheduleEntryInstant } from '../../../../lib/calendar';
import { MONTH_LABELS } from '../../../../lib/minorFormContent';
import { asset } from '../../../../lib/asset';
import { getPlatformLabels, makeLabelGetter } from '../../../../lib/platformLabels';

const DIRECTUS_URL = import.meta.env.DIRECTUS_URL;

const member = await requireMember(Astro.request);
if (!member) {
  return Astro.redirect('/platform/login');
}
const L = makeLabelGetter(await getPlatformLabels());

const id = Number(Astro.params.id);
const cloud =
  member.clouds.find((c) => c.clouds_id.id === id)?.clouds_id ??
  member.facilitates_clouds.find((c) => c.clouds_id.id === id)?.clouds_id ??
  null;
if (!cloud) {
  return Astro.redirect('/platform/library');
}

const schedule = formatScheduleLabel(cloud.day_of_week, cloud.start_time, cloud.end_time);
const scheduleInstants = parseDays(cloud.day_of_week)
  .map((day) => {
    const start = scheduleEntryInstant(day, cloud.start_time);
    const end = scheduleEntryInstant(day, cloud.end_time);
    return start && end ? { start: start.toISOString(), end: end.toISOString() } : null;
  })
  .filter((e): e is { start: string; end: string } => e !== null);

interface Material {
  id: number;
  type: 'video' | 'audio' | 'reading';
  label: string;
  url: string | null;
  text: string | null;
  review_status: string | null;
  file: { id: string; kind: string; purpose: string; review_status: string | null } | null;
  week_start: string;
}

let materials: Material[] = [];
try {
  const res = await adminGet(
    `/items/materials?filter[cloud][_eq]=${id}&sort=-week_start,sort,label&fields=id,type,label,url,text,review_status,file.id,file.kind,file.purpose,file.review_status,week_start&limit=-1`
  );
  materials = res.data ?? [];
  // Files still waiting for (or refused by) the moderator: only the group's
  // facilitators and the team see those materials.
  if (!facilitatesGroup(member, null, id) && member.role !== 'team') {
    materials = materials.filter((m) => materialApproved(m));
  }
} catch (e) {
  console.error('Failed to load cloud materials:', e);
}

let facilitators: { full_name: string; armenian_name: string | null; image: string | null }[] = [];
let participants: { id: number; full_name: string; armenian_name: string | null; role: string | null }[] = [];
try {
  const [facilitatorsRes, participantsRes] = await Promise.all([
    adminGet(`/items/platform_members?filter[facilitates_clouds][clouds_id][_eq]=${id}&sort=full_name&fields=full_name,armenian_name,image&limit=-1`),
    adminGet(`/items/platform_members?filter[clouds][clouds_id][_eq]=${id}&sort=full_name&fields=id,full_name,armenian_name,role&limit=-1`),
  ]);
  facilitators = facilitatorsRes.data ?? [];
  participants = participantsRes.data ?? [];
} catch (e) {
  console.error('Failed to load cloud roster:', e);
}

// The group's facilitators (and the team) can write to a participant by name.
const canMessage = member.role === 'team' || facilitatesGroup(member, null, id);

// Participants send their work to this group's facilitators from here.
const canSubmit = enrolledInGroup(member, null, id);
const mySubmissions = canSubmit ? await ownSubmissions(member.id, 'cloud', id) : [];
// The participant's own use of each material ("Բացուած", "65%", "Աւարտած").
const myViews = canSubmit ? await viewsFor(materials.map((m) => m.id), member.id) : [];
function progressLabel(m: Material): string | null {
  const v = myViews.find((x) => x.material === m.id);
  if (!v) return null;
  if (v.completed_at) return L('material_completed', 'Աւարտած');
  const pct = m.file && (m.file.kind === 'video' || m.file.kind === 'audio') ? percentReached(v) : null;
  return pct !== null ? `${pct}%` : L('material_opened', 'Բացուած');
}

const weekGroups = new Map<string, Material[]>();
for (const m of materials) {
  const list = weekGroups.get(m.week_start) ?? [];
  list.push(m);
  weekGroups.set(m.week_start, list);
}

const MONTH_SHORT = MONTH_LABELS.hyw;
function formatWeek(weekStart: string): string {
  const d = new Date(`${weekStart}T00:00:00`);
  const end = new Date(d.getFullYear(), d.getMonth(), d.getDate() + 6);
  return `${MONTH_SHORT[d.getMonth()]} ${d.getDate()} – ${MONTH_SHORT[end.getMonth()]} ${end.getDate()}`;
}

const TYPE_LABEL: Record<Material['type'], string> = {
  video: L('material_type_video', 'Video'),
  audio: L('material_type_audio', 'Audio'),
  reading: L('material_type_reading', 'Reading'),
};
---

<PlatformLayout title={`Zartsants Platform — ${cloud.name}`} member={member}>
  <style>
    .container { max-width: 700px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
    @media (max-width: 640px) { .container { padding: 1.5rem 1rem 2.5rem; } }
    .back { display: inline-block; color: #666; text-decoration: none; font-size: 0.85rem; margin-bottom: 1rem; }
    .back:hover { text-decoration: underline; }

    .hero {
      background: #fff6d6;
      border-radius: 16px;
      padding: 1.5rem;
      display: flex;
      align-items: center;
      gap: 1.25rem;
      margin-bottom: 2rem;
    }
    .hero img { height: 76px; width: auto; flex-shrink: 0; }
    .hero.has-image {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0;
      overflow: hidden;
    }
    .hero.has-image img.full { width: 100%; height: 400px; object-fit: contain; display: block; background: #fff6d6; }
    .hero.has-image .hero-body { padding: 1.5rem; }
    @media (max-width: 640px) {
      .hero.has-image img.full { height: 220px; }
      .hero.has-image .hero-body { padding: 1.1rem 1.25rem 1.25rem; }
    }
    .hero h1 { font-size: 1.3rem; font-weight: 700; }
    .hero .schedule { font-size: 0.85rem; color: #5c4f00; margin-top: 0.3rem; }
    .hero .zoom {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      margin-top: 0.7rem;
      background: #fff;
      color: #7a6600;
      font-weight: 700;
      font-size: 0.8rem;
      padding: 0.4rem 0.85rem;
      border-radius: 999px;
      text-decoration: none;
    }
    .hero .zoom svg { height: 0.85em; width: auto; aspect-ratio: 20 / 12; flex-shrink: 0; }
    .hero .zoom:hover { opacity: 0.85; }

    .week { margin-bottom: 1.75rem; }
    .week-label {
      font-size: 0.72rem;
      font-weight: 700;
      color: #9a9a94;
      margin-bottom: 0.75rem;
    }
    .sections { display: flex; flex-direction: column; gap: 1rem; }
    .section { background: #fff; border: 1px solid #e9e9e4; border-radius: 12px; padding: 1rem 1.25rem; }
    .section h2 { font-size: 0.9rem; font-weight: 700; margin-bottom: 0.6rem; }
    .section ul { list-style: none; display: flex; flex-direction: column; gap: 0.45rem; }
    .section a { color: #4a3fcf; text-decoration: none; font-size: 0.9rem; }
    .section a:hover { text-decoration: underline; }
    .section li { display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem; }
    .section .progress { font-size: 0.75rem; color: #2e9e4f; white-space: nowrap; }

    .submissions { margin-top: 2.5rem; }
    .submissions h2 { font-size: 1.1rem; font-weight: 700; margin-bottom: 0.4rem; }
    .submissions-intro { font-size: 0.88rem; color: #666; margin-bottom: 1rem; }
    .submissions-list { margin-top: 1.25rem; }

    .empty-state {
      background: #fff;
      border: 1px solid #e9e9e4;
      border-radius: 14px;
      padding: 2.5rem 1.5rem;
      text-align: center;
      color: #888;
    }

    .roster { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.75rem; }
    .roster .section h2 { display: flex; align-items: center; justify-content: space-between; }
    .roster .count { font-weight: 400; color: #9a9a94; font-size: 0.8rem; }
    .roster .names { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .roster .names .name-link {
      background: #efeaff;
      color: #4a3fcf;
      border-radius: 999px;
      padding: 0.3rem 0.75rem;
      font-size: 0.85rem;
      text-decoration: none;
    }
    .roster .names .name-link:hover { background: #e3dcff; }
    .roster .names span {
      background: #f7f4ee;
      border-radius: 999px;
      padding: 0.3rem 0.75rem;
      font-size: 0.85rem;
    }
    .roster .facilitator-chip {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background: #f7f4ee;
      border-radius: 999px;
      padding: 0.35rem 1.1rem 0.35rem 0.35rem;
      font-size: 0.95rem;
    }
    .roster .facilitator-chip img,
    .roster .facilitator-chip .avatar-fallback {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
    }
    .roster .facilitator-chip .avatar-fallback {
      background: #fdf0b8;
      color: #7a6600;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 2.25rem;
    }
  </style>

  <div class="container">
    <a class="back" href="/platform/library">&larr; {L('detail_back_to_library', 'Library')}</a>

    <div class={`hero ${cloud.image ? 'has-image' : ''}`}>
      {cloud.image ? (
        <img class="full" src={asset(DIRECTUS_URL, cloud.image)!} alt="" />
      ) : (
        <img src="/cloud.png" alt="" />
      )}
      <div class={cloud.image ? 'hero-body' : undefined}>
        <h1>{cloud.name}</h1>
        {schedule && (
          <div class="schedule" data-schedule={JSON.stringify(scheduleInstants)}>{schedule}</div>
        )}
        <a class="zoom" href={cloud.bundle.zoom_link} target="_blank" rel="noopener">
          <svg viewBox="2 6 20 12" fill="currentColor" aria-hidden="true"><rect x="2" y="6" width="13.5" height="12" rx="3"/><path d="M17 10.2 21 7.4a.6.6 0 0 1 1 .5v8.2a.6.6 0 0 1-1 .5L17 13.8Z"/></svg>
          {L('detail_join_zoom', 'Join Zoom')}
        </a>
      </div>
    </div>

    <div class="roster">
      <div class="section">
        <h2>{L('detail_facilitators_heading', 'Ուղեկից')} <span class="count">{facilitators.length}</span></h2>
        {facilitators.length === 0 ? (
          <p class="empty-state" style="padding:0.5rem 0;background:none;border:none;">{L('detail_facilitators_empty', 'Not assigned yet.')}</p>
        ) : (
          <div class="names">
            {facilitators.map((f) => (
              <span class="facilitator-chip">
                {f.image ? (
                  <img src={asset(DIRECTUS_URL, f.image)!} alt="" />
                ) : (
                  <span class="avatar-fallback">{displayName(f).trim().charAt(0).toUpperCase()}</span>
                )}
                {displayName(f)}
              </span>
            ))}
          </div>
        )}
      </div>
      <div class="section">
        <h2>{L('detail_participants_heading', 'Մասնակիցներ')} <span class="count">{participants.length}</span></h2>
        {participants.length === 0 ? (
          <p class="empty-state" style="padding:0.5rem 0;background:none;border:none;">{L('detail_participants_empty', 'Տակաւին մասնակիցներ չկան։')}</p>
        ) : (
          <div class="names">
            {participants.map((p) =>
              canMessage && p.role === 'student' ? (
                <a class="name-link" href={`/platform/message/${p.id}?cloud=${id}`} title={L('message_write_to', 'Նամակ գրել')}>✉ {displayName(p)}</a>
              ) : (
                <span>{displayName(p)}</span>
              )
            )}
          </div>
        )}
      </div>
    </div>

    {materials.length === 0 ? (
      <div class="empty-state">{L('detail_materials_empty', 'No materials shared yet.')}</div>
    ) : (
      [...weekGroups.entries()].map(([weekStart, items]) => (
        <div class="week">
          <div class="week-label">{formatWeek(weekStart)}</div>
          <div class="sections">
            {(['video', 'audio', 'reading'] as const).map((type) => {
              const typeItems = items.filter((m) => m.type === type);
              if (typeItems.length === 0) return null;
              return (
                <div class="section">
                  <h2>{TYPE_LABEL[type]}</h2>
                  <ul>
                    {typeItems.map((m) => (
                      <li>
                        <a href={m.file || m.text ? `/platform/view/${m.id}` : isWebUrl(m.url) ? `/api/platform/materials/${m.id}/open` : undefined} target={m.file || m.text ? undefined : '_blank'} rel="noopener">{m.label}</a>
                        {progressLabel(m) && <span class="progress">✓ {progressLabel(m)}</span>}
                      </li>
                    ))}
                  </ul>
                </div>
              );
            })}
          </div>
        </div>
      ))
    )}

    {canSubmit && (
      <section class="submissions" id="submissions">
        <h2>{L('submissions_title', 'Իմ աշխատանքներս')}</h2>
        <p class="submissions-intro">{L('submissions_intro', 'Հոս կրնաս ղրկել քու աշխատանքդ ուղեկիցներուդ՝ գրութիւն, նկար, ձայներիզ կամ տեսերիզ։')}</p>
        <SubmissionComposer
          endpoint="/api/platform/submissions"
          purpose="submission"
          textField="note"
          extra={{ cloud: id }}
          placeholder={L('submission_note_placeholder', 'Գրութիւն (ըստ ընտրութեան)')}
          submitLabel={L('submission_send', 'Ղրկել')}
        />
        <div class="submissions-list">
          <SubmissionList
            submissions={mySubmissions}
            showAuthor={false}
            timezone={memberTimezone(member)}
            emptyText={L('submissions_empty', 'Տակաւին աշխատանք չես ղրկած։')}
          />
        </div>
      </section>
    )}
  </div>
</PlatformLayout>
