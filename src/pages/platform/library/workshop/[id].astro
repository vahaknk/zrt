---
import PlatformLayout from '../../../../layouts/PlatformLayout.astro';
import { requireMember, displayName } from '../../../../lib/platformAuth';
import { adminGet } from '../../../../lib/directusAdmin';
import { formatWorkshopScheduleLabel, scheduleEntryInstant } from '../../../../lib/calendar';
import { MONTH_LABELS } from '../../../../lib/minorFormContent';
import { asset } from '../../../../lib/asset';
import { getPlatformLabels, makeLabelGetter } from '../../../../lib/platformLabels';

const DIRECTUS_URL = import.meta.env.DIRECTUS_URL;

const member = await requireMember(Astro.request);
if (!member) {
  return Astro.redirect('/platform/login');
}
const L = makeLabelGetter(await getPlatformLabels());

const id = Number(Astro.params.id);
const workshop = member.workshop?.id === id ? member.workshop : null;
if (!workshop) {
  return Astro.redirect('/platform/library');
}

const schedule = formatWorkshopScheduleLabel(workshop.schedule);
const scheduleInstants = (workshop.schedule ?? [])
  .map((e) => {
    const start = scheduleEntryInstant(e.day, e.start_time);
    const end = scheduleEntryInstant(e.day, e.end_time);
    return start && end ? { start: start.toISOString(), end: end.toISOString() } : null;
  })
  .filter((e): e is { start: string; end: string } => e !== null);

interface Material {
  id: number;
  type: 'video' | 'audio' | 'reading';
  label: string;
  url: string;
  week_start: string;
}

let materials: Material[] = [];
try {
  const res = await adminGet(
    `/items/materials?filter[workshop][_eq]=${id}&sort=-week_start,sort,label&fields=id,type,label,url,week_start&limit=-1`
  );
  materials = res.data ?? [];
} catch (e) {
  console.error('Failed to load workshop materials:', e);
}

let facilitators: { full_name: string; armenian_name: string | null; image: string | null }[] = [];
let participants: { full_name: string; armenian_name: string | null }[] = [];
try {
  const [facilitatorsRes, participantsRes] = await Promise.all([
    adminGet(`/items/platform_members?filter[facilitates_workshops][workshops_id][_eq]=${id}&sort=full_name&fields=full_name,armenian_name,image&limit=-1`),
    adminGet(`/items/platform_members?filter[workshop][_eq]=${id}&sort=full_name&fields=full_name,armenian_name&limit=-1`),
  ]);
  facilitators = facilitatorsRes.data ?? [];
  participants = participantsRes.data ?? [];
} catch (e) {
  console.error('Failed to load workshop roster:', e);
}

const weekGroups = new Map<string, Material[]>();
for (const m of materials) {
  const list = weekGroups.get(m.week_start) ?? [];
  list.push(m);
  weekGroups.set(m.week_start, list);
}

const MONTH_SHORT = MONTH_LABELS.hyw;
function formatWeek(weekStart: string): string {
  const d = new Date(`${weekStart}T00:00:00`);
  const end = new Date(d.getFullYear(), d.getMonth(), d.getDate() + 6);
  return `${MONTH_SHORT[d.getMonth()]} ${d.getDate()} – ${MONTH_SHORT[end.getMonth()]} ${end.getDate()}`;
}

const TYPE_LABEL: Record<Material['type'], string> = {
  video: L('material_type_video', 'Video'),
  audio: L('material_type_audio', 'Audio'),
  reading: L('material_type_reading', 'Reading'),
};
---

<PlatformLayout title={`Zartsants Platform — ${workshop.name}`} member={member}>
  <style>
    .container { max-width: 700px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
    .back { display: inline-block; color: #666; text-decoration: none; font-size: 0.85rem; margin-bottom: 1rem; }
    .back:hover { text-decoration: underline; }

    .hero {
      background: #efeaff;
      border-radius: 16px;
      padding: 1.5rem;
      display: flex;
      align-items: center;
      gap: 1.25rem;
      margin-bottom: 2rem;
    }
    .hero img { height: 76px; width: auto; flex-shrink: 0; }
    .hero.has-image {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0;
      overflow: hidden;
    }
    .hero.has-image img.full { width: 100%; height: 400px; object-fit: contain; display: block; background: #efeaff; }
    .hero.has-image .hero-body { padding: 1.5rem; }
    .hero h1 { font-size: 1.3rem; font-weight: 700; }
    .hero .schedule { font-size: 0.85rem; color: #4a4460; margin-top: 0.3rem; }
    .hero .zoom {
      display: inline-block;
      margin-top: 0.7rem;
      background: #fff;
      color: #4a3fcf;
      font-weight: 700;
      font-size: 0.8rem;
      padding: 0.4rem 0.85rem;
      border-radius: 999px;
      text-decoration: none;
    }
    .hero .zoom:hover { opacity: 0.85; }

    .week { margin-bottom: 1.75rem; }
    .week-label {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #9a9a94;
      margin-bottom: 0.75rem;
    }
    .sections { display: flex; flex-direction: column; gap: 1rem; }
    .section { background: #fff; border: 1px solid #e9e9e4; border-radius: 12px; padding: 1rem 1.25rem; }
    .section h2 { font-size: 0.9rem; font-weight: 700; margin-bottom: 0.6rem; }
    .section ul { list-style: none; display: flex; flex-direction: column; gap: 0.45rem; }
    .section a { color: #4a3fcf; text-decoration: none; font-size: 0.9rem; }
    .section a:hover { text-decoration: underline; }

    .empty-state {
      background: #fff;
      border: 1px solid #e9e9e4;
      border-radius: 14px;
      padding: 2.5rem 1.5rem;
      text-align: center;
      color: #888;
    }

    .roster { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.75rem; }
    .roster .section h2 { display: flex; align-items: center; justify-content: space-between; }
    .roster .count { font-weight: 400; color: #9a9a94; font-size: 0.8rem; }
    .roster .names { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .roster .names span {
      background: #f6f6f4;
      border-radius: 999px;
      padding: 0.3rem 0.75rem;
      font-size: 0.85rem;
    }
    .roster .facilitator-chip {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background: #f6f6f4;
      border-radius: 999px;
      padding: 0.35rem 1.1rem 0.35rem 0.35rem;
      font-size: 0.95rem;
    }
    .roster .facilitator-chip img,
    .roster .facilitator-chip .avatar-fallback {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
    }
    .roster .facilitator-chip .avatar-fallback {
      background: #ddd8f5;
      color: #4a3fcf;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 2.25rem;
    }
  </style>

  <div class="container">
    <a class="back" href="/platform/library">&larr; {L('detail_back_to_library', 'Library')}</a>

    <div class={`hero ${workshop.image ? 'has-image' : ''}`}>
      {workshop.image ? (
        <img class="full" src={asset(DIRECTUS_URL, workshop.image)!} alt="" />
      ) : (
        <img src="/lamp.png" alt="" />
      )}
      <div class={workshop.image ? 'hero-body' : undefined}>
        <h1>{workshop.name}</h1>
        {schedule && (
          <div class="schedule" data-schedule={JSON.stringify(scheduleInstants)}>{schedule}</div>
        )}
        <a class="zoom" href={workshop.zoom_link} target="_blank" rel="noopener">{L('detail_join_zoom', 'Join Zoom')}</a>
      </div>
    </div>

    <div class="roster">
      <div class="section">
        <h2>{L('detail_facilitators_heading', 'Ուղեկից')} <span class="count">{facilitators.length}</span></h2>
        {facilitators.length === 0 ? (
          <p class="empty-state" style="padding:0.5rem 0;background:none;border:none;">{L('detail_facilitators_empty', 'Not assigned yet.')}</p>
        ) : (
          <div class="names">
            {facilitators.map((f) => (
              <span class="facilitator-chip">
                {f.image ? (
                  <img src={asset(DIRECTUS_URL, f.image)!} alt="" />
                ) : (
                  <span class="avatar-fallback">{displayName(f).trim().charAt(0).toUpperCase()}</span>
                )}
                {displayName(f)}
              </span>
            ))}
          </div>
        )}
      </div>
      <div class="section">
        <h2>{L('detail_participants_heading', 'Մասնակիցներ')} <span class="count">{participants.length}</span></h2>
        {participants.length === 0 ? (
          <p class="empty-state" style="padding:0.5rem 0;background:none;border:none;">{L('detail_participants_empty', 'No one enrolled yet.')}</p>
        ) : (
          <div class="names">{participants.map((p) => <span>{displayName(p)}</span>)}</div>
        )}
      </div>
    </div>

    {materials.length === 0 ? (
      <div class="empty-state">{L('detail_materials_empty', 'No materials shared yet.')}</div>
    ) : (
      [...weekGroups.entries()].map(([weekStart, items]) => (
        <div class="week">
          <div class="week-label">{formatWeek(weekStart)}</div>
          <div class="sections">
            {(['video', 'audio', 'reading'] as const).map((type) => {
              const typeItems = items.filter((m) => m.type === type);
              if (typeItems.length === 0) return null;
              return (
                <div class="section">
                  <h2>{TYPE_LABEL[type]}</h2>
                  <ul>
                    {typeItems.map((m) => (
                      <li><a href={m.url} target="_blank" rel="noopener">{m.label}</a></li>
                    ))}
                  </ul>
                </div>
              );
            })}
          </div>
        </div>
      ))
    )}
  </div>
</PlatformLayout>
