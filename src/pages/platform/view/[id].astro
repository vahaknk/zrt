---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import FileStage from '../../../components/FileStage.astro';
import ReviewPanel from '../../../components/ReviewPanel.astro';
import { requireMember, hasFacilitatorPage } from '../../../lib/platformAuth';
import { getMaterial, canSeeMaterial, isTracked, recordOpen } from '../../../lib/materialViews';
import { facilitatesGroup } from '../../../lib/submissions';
import { getPlatformLabels, makeLabelGetter } from '../../../lib/platformLabels';

// A file or written material, shown inside the platform (player / viewer /
// text) so its use can be measured; downloading only when the facilitator
// allowed it.
const member = await requireMember(Astro.request);
if (!member) {
  return Astro.redirect(`/platform/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
const material = await getMaterial(Number(Astro.params.id));
const hasContent = !!material?.text || (!!material?.file && material.file.status !== 'uploading');
if (!material || !hasContent || !canSeeMaterial(member, material)) {
  return Astro.redirect('/platform/library');
}
const L = makeLabelGetter(await getPlatformLabels());
const tracked = isTracked(member, material);
if (tracked) await recordOpen(member.id, material.id).catch((e) => console.error('recordOpen failed:', e));

const file = material.file;
const group = material.workshop ?? material.cloud;
const manages = facilitatesGroup(member, material.workshop?.id ?? null, material.cloud?.id ?? null);
const back = manages && hasFacilitatorPage(member)
  ? { href: '/platform/facilitator', label: L('nav_facilitator', 'Փեթակ') }
  : { href: `/platform/library/${material.workshop ? 'workshop' : 'cloud'}/${group?.id}`, label: group?.name ?? '' };
const canDownload = !!file && (file.allow_download || manages || member.role === 'team');
// Written texts are reviewed per material (files are reviewed on their own page).
const textReview = material.text ? material.review_status ?? 'approved' : null;
const showReviewPanel = !!textReview && !!member.moderator && material.author !== member.id;
const showReviewStatus = !!textReview && material.author === member.id && textReview !== 'approved';
---

<PlatformLayout title={`Zartsants Platform — ${material.label}`} member={member}>
  <style>
    .container { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
    @media (max-width: 640px) { .container { padding: 1.5rem 1rem 2.5rem; } }
    .back { display: inline-block; color: #666; text-decoration: none; font-size: 0.85rem; margin-bottom: 1rem; }
    .back:hover { text-decoration: underline; }
    h1 { font-size: 1.3rem; font-weight: 700; margin-bottom: 1.25rem; }
    .text-material {
      background: #fff;
      border: 1px solid #e9e9e4;
      border-radius: 14px;
      padding: 1.5rem 1.75rem;
      font-size: 1rem;
      line-height: 1.7;
      white-space: pre-wrap;
      word-break: break-word;
    }
  </style>

  <div class="container">
    <a class="back" href={back.href}>&larr; {back.label}</a>
    <h1>{material.label}</h1>
    {showReviewPanel && <ReviewPanel mode="moderator" subject="text" status={textReview!} note={material.review_note} endpoint={`/api/platform/materials/${material.id}/review`} />}
    {showReviewStatus && <ReviewPanel mode="owner" subject="text" status={textReview!} note={material.review_note} endpoint="" />}
    {material.text ? (
      <div class="text-material">{material.text}</div>
    ) : (
      file && <FileStage file={file} title={material.label} canDownload={canDownload} trackMaterialId={tracked ? material.id : null} />
    )}
  </div>
</PlatformLayout>
