---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { requireMember, hasFacilitatorPage } from '../../../lib/platformAuth';
import { getMaterial, canSeeMaterial, isTracked, recordOpen } from '../../../lib/materialViews';
import { facilitatesGroup } from '../../../lib/submissions';
import { getPlatformLabels, makeLabelGetter } from '../../../lib/platformLabels';

// A file material, shown inside the platform (player / viewer) so its use
// can be measured; downloading only when the facilitator allowed it.
const member = await requireMember(Astro.request);
if (!member) {
  return Astro.redirect(`/platform/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
const material = await getMaterial(Number(Astro.params.id));
if (!material || !material.file || material.file.status === 'uploading' || !canSeeMaterial(member, material)) {
  return Astro.redirect('/platform/library');
}
const L = makeLabelGetter(await getPlatformLabels());
const tracked = isTracked(member, material);
if (tracked) await recordOpen(member.id, material.id).catch((e) => console.error('recordOpen failed:', e));

const file = material.file;
const src = `/api/platform/files/${file.id}`;
const group = material.workshop ?? material.cloud;
const manages = facilitatesGroup(member, material.workshop?.id ?? null, material.cloud?.id ?? null);
const back = manages && hasFacilitatorPage(member)
  ? { href: '/platform/facilitator', label: L('nav_facilitator', 'Փեթակ') }
  : { href: `/platform/library/${material.workshop ? 'workshop' : 'cloud'}/${group?.id}`, label: group?.name ?? '' };
const canDownload = file.allow_download || manages || member.role === 'team';
const isPdf = file.mime === 'application/pdf' || file.filename.toLowerCase().endsWith('.pdf');
---

<PlatformLayout title={`Zartsants Platform — ${material.label}`} member={member}>
  <style>
    .container { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
    @media (max-width: 640px) { .container { padding: 1.5rem 1rem 2.5rem; } }
    .back { display: inline-block; color: #666; text-decoration: none; font-size: 0.85rem; margin-bottom: 1rem; }
    .back:hover { text-decoration: underline; }
    h1 { font-size: 1.3rem; font-weight: 700; margin-bottom: 1.25rem; }
    .stage { background: #fff; border: 1px solid #e9e9e4; border-radius: 14px; overflow: hidden; }
    .stage video, .stage img { display: block; width: 100%; max-height: 75vh; background: #111; object-fit: contain; }
    .stage img { background: #f7f4ee; user-select: none; -webkit-user-drag: none; -webkit-touch-callout: none; }
    .stage audio { display: block; width: 100%; padding: 1.5rem; box-sizing: border-box; }
    .stage iframe { display: block; width: 100%; height: 80vh; border: 0; }
    .stage .no-preview { padding: 2rem 1.5rem; color: #666; font-size: 0.9rem; }
    .actions { margin-top: 1rem; display: flex; justify-content: flex-end; }
    .download {
      padding: 0.5rem 1.1rem;
      background: #1a1a1a;
      color: #fff;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.8rem;
      text-decoration: none;
    }
  </style>

  <div class="container">
    <a class="back" href={back.href}>&larr; {back.label}</a>
    <h1>{material.label}</h1>

    <div class="stage" data-no-save>
      {file.kind === 'video' ? (
        <video
          id="player"
          src={src}
          controls
          playsinline
          preload="metadata"
          controlslist="nodownload noremoteplayback"
          disablepictureinpicture
        ></video>
      ) : file.kind === 'audio' ? (
        <audio id="player" src={src} controls preload="metadata" controlslist="nodownload"></audio>
      ) : file.kind === 'image' ? (
        <img src={src} alt={material.label} draggable="false" />
      ) : isPdf ? (
        <iframe src={src} title={material.label}></iframe>
      ) : (
        <p class="no-preview">{L('viewer_no_preview', 'Այս ծրարը հարթակին վրայ չի կրնար ցուցադրուիլ։')}</p>
      )}
    </div>

    {canDownload && (
      <div class="actions">
        <a class="download" href={`${src}?download=1`}>{L('viewer_download', 'Ներբեռնել')}</a>
      </div>
    )}
  </div>

  <script define:vars={{ materialId: material.id, tracked }}>
    // No right-click "save as" on the media (it can't stop a determined
    // person, but keeps saving from being the obvious thing to do).
    document.querySelector('[data-no-save]')?.addEventListener('contextmenu', (e) => e.preventDefault());

    const player = document.getElementById('player');
    if (player && tracked) {
      // Count only real playback: time advancing in small steps while playing,
      // not jumps from seeking.
      let played = 0;
      let last = null;
      player.addEventListener('timeupdate', () => {
        const t = player.currentTime;
        if (last !== null && !player.paused) {
          const step = t - last;
          if (step > 0 && step < 2) played += step;
        }
        last = t;
      });
      player.addEventListener('seeking', () => (last = player.currentTime));
      const send = (beacon) => {
        if (played < 1 && player.currentTime < 1) return;
        const body = JSON.stringify({ delta: Math.round(played), position: Math.round(player.currentTime), duration: Math.round(player.duration || 0) });
        played = 0;
        const url = `/api/platform/views/${materialId}`;
        if (beacon && navigator.sendBeacon) navigator.sendBeacon(url, new Blob([body], { type: 'application/json' }));
        else fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body, keepalive: true }).catch(() => {});
      };
      setInterval(() => { if (!player.paused) send(false); }, 15000);
      player.addEventListener('pause', () => send(false));
      player.addEventListener('ended', () => send(false));
      document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') send(true); });
    }
  </script>
</PlatformLayout>
