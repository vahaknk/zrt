---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import { requireMember } from '../../lib/platformAuth';

const member = await requireMember(Astro.request);
if (!member) {
  return Astro.redirect('/platform/login');
}

const workshop = member.workshop;
// Effectively one bundle per member in practice — use the first.
const cloudBundle = member.clouds[0]?.clouds_id?.bundle ?? null;
const cloudNames = member.clouds.map((c) => c.clouds_id.name).join(', ');
---

<PlatformLayout title="Zartsants Platform" member={member}>
  <style>
    .container { max-width: 780px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
    h1 { font-size: 1.35rem; font-weight: 700; margin-bottom: 1.75rem; }

    .image-row {
      display: flex;
      gap: 1rem;
      margin-top: 5rem;
      margin-bottom: 2rem;
    }
    .tile-image {
      display: flex;
      flex-direction: column;
      width: 250px;
      background: #fff;
      border: 1px solid #e9e9e4;
      border-radius: 14px;
      overflow: visible;
      text-decoration: none;
      color: inherit;
      transition: box-shadow 0.15s, transform 0.15s;
    }
    .tile-image:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.07); transform: translateY(-1px); }
    .tile-image-figure {
      height: 200px;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      overflow: visible;
    }
    .tile-image-figure img {
      max-width: 118%;
      max-height: 118%;
      width: auto;
      height: auto;
      display: block;
      position: relative;
      transform: translateY(-26px);
      transition: transform 0.2s ease;
    }
    .tile-image:hover .tile-image-figure img { transform: translateY(-32px) scale(1.08); }
    .tile-image-title { padding: 0.85rem 1rem 1rem; font-weight: 700; font-size: 0.95rem; }

    .group { margin-bottom: 2rem; }
    .group-label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: #9a9a94;
      margin-bottom: 3.5rem;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    .course {
      display: block;
      background: #fff;
      border: 1px solid #e9e9e4;
      border-radius: 14px;
      overflow: visible;
      text-decoration: none;
      color: inherit;
      transition: box-shadow 0.15s, transform 0.15s;
    }
    a.course:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.07); transform: translateY(-1px); }
    .course-banner {
      height: 160px;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      background: var(--banner, #f1f0ea);
      border-top-left-radius: 13px;
      border-top-right-radius: 13px;
      overflow: visible;
    }
    .course-banner img {
      height: 150px;
      width: auto;
      display: block;
      position: relative;
      transform: translateY(-24px);
      transition: transform 0.2s ease;
    }
    a.course:hover .course-banner img { transform: translateY(-30px) scale(1.08); }
    .course-body { padding: 0.85rem 1rem 1rem; }
    .course-title { font-weight: 700; font-size: 0.95rem; }
    .course-sub { font-size: 0.78rem; color: #797970; margin-top: 0.2rem; }

    .course.disabled { cursor: default; }
    .course.disabled .course-banner { filter: grayscale(1); opacity: 0.55; }
    .course.disabled .course-title { color: #a8a8a0; }
    .course.disabled .course-sub { color: #b8b8b0; }

    @media (max-width: 480px) {
      .grid { grid-template-columns: 1fr; }
      .image-row { flex-wrap: wrap; justify-content: center; row-gap: 3.5rem; }
      .tile-image { width: 160px; }
      .tile-image-figure { height: 130px; }
    }
  </style>

  <div class="container">
    <h1>Բարեւ, {member.full_name}</h1>

    <div class="image-row">
      <a class="tile-image" href="/platform/parev">
        <div class="tile-image-figure"><img src="/platform_parev.png" alt="" /></div>
        <div class="tile-image-title">Բարեւ</div>
      </a>
      <a class="tile-image" href="/platform/calendar">
        <div class="tile-image-figure"><img src="/platform_calendar.png" alt="" /></div>
        <div class="tile-image-title">Օրացոյց</div>
      </a>
      <a class="tile-image" href="/platform/library">
        <div class="tile-image-figure"><img src="/platform_library.png" alt="" /></div>
        <div class="tile-image-title">Գրադարան</div>
      </a>
    </div>

    <div class="group">
      <div class="group-label">Դէպի աշխատանոցներ եւ ամպեր</div>
      <div class="grid">
        {workshop ? (
          <a class="course" href={workshop.zoom_link} target="_blank" rel="noopener">
            <div class="course-banner" style="--banner:#efeaff">
              <img src="/whats_there_pic_2.webp" alt="" />
            </div>
            <div class="course-body">
              <div class="course-title">Աշխատանոց 🖥️</div>
              <div class="course-sub">{workshop.name}</div>
            </div>
          </a>
        ) : (
          <div class="course disabled">
            <div class="course-banner" style="--banner:#efeaff">
              <img src="/whats_there_pic_2.webp" alt="" />
            </div>
            <div class="course-body">
              <div class="course-title">Աշխատանոց 🖥️</div>
              <div class="course-sub">Not assigned yet</div>
            </div>
          </div>
        )}
        {cloudBundle ? (
          <a class="course" href={cloudBundle.zoom_link} target="_blank" rel="noopener">
            <div class="course-banner" style="--banner:#fff6d6">
              <img src="/bird.png" alt="" />
            </div>
            <div class="course-body">
              <div class="course-title">Ամպեր 🖥️</div>
              <div class="course-sub">{cloudNames}</div>
            </div>
          </a>
        ) : (
          <div class="course disabled">
            <div class="course-banner" style="--banner:#fff6d6">
              <img src="/bird.png" alt="" />
            </div>
            <div class="course-body">
              <div class="course-title">Ամպեր 🖥️</div>
              <div class="course-sub">Not assigned yet</div>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</PlatformLayout>
