---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import PlatformCalendar from '../../components/PlatformCalendar.astro';
import { requireMember, memberTimezone, displayName, memberGroups } from '../../lib/platformAuth';
import { getPlatformLabels, makeLabelGetter } from '../../lib/platformLabels';
import { listNotifications, notificationText } from '../../lib/notifications';

const member = await requireMember(Astro.request);
if (!member) {
  return Astro.redirect('/platform/login');
}

const { workshops, clouds } = await memberGroups(member);
const L = makeLabelGetter(await getPlatformLabels());
// The few latest unread notifications, above the tiles.
const latest = await listNotifications(member.id, { unreadOnly: true, limit: 5 });
---

<PlatformLayout title="Zartsants Platform" member={member}>
  <style>
    .container { max-width: 780px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
    h1 { font-size: 1.35rem; font-weight: 700; margin-bottom: 1.75rem; }

    .image-row {
      display: flex;
      gap: 1rem;
      margin-top: 5rem;
      margin-bottom: 3.5rem;
    }
    .tile-image {
      display: flex;
      flex-direction: column;
      width: 250px;
      background: #fff;
      border: 1px solid #e9e9e4;
      border-radius: 14px;
      overflow: visible;
      text-decoration: none;
      color: inherit;
      transition: box-shadow 0.15s, transform 0.15s;
    }
    .tile-image:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.07); transform: translateY(-1px); }
    .tile-image-figure {
      height: 200px;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      overflow: visible;
    }
    .tile-image-figure img {
      max-width: 118%;
      max-height: 118%;
      width: auto;
      height: auto;
      display: block;
      position: relative;
      transform: translateY(-26px);
      transition: transform 0.2s ease;
    }
    .tile-image:hover .tile-image-figure img { transform: translateY(-32px) scale(1.08); }
    .tile-image-figure img.icon-sm {
      max-width: 60%;
      max-height: 60%;
      transform: translateY(-14px);
    }
    .tile-image:hover .tile-image-figure img.icon-sm { transform: translateY(-18px) scale(1.08); }
    .tile-image-title { padding: 0.85rem 1rem 1rem; font-weight: 700; font-size: 0.95rem; }

    @media (max-width: 640px) {
      .container { padding: 1.5rem 1rem 2.5rem; }
      .image-row { gap: 0.6rem; margin-top: 3rem; margin-bottom: 2.5rem; }
      .tile-image { flex: 1 1 0; width: auto; min-width: 0; }
      .tile-image-figure { height: 92px; }
      .tile-image-figure img { transform: translateY(-14px); }
      .tile-image-figure img.icon-sm { transform: translateY(-8px); }
      .tile-image-title { padding: 0.6rem 0.4rem 0.7rem; font-size: 0.8rem; text-align: center; }
    }
    .new-box { background: #fff; border: 1px solid #e9e9e4; border-left: 4px solid #7a63f5; border-radius: 14px; padding: 1rem 1.25rem; margin-bottom: 1.75rem; }
    .new-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem; }
    .new-head h2 { font-size: 1rem; font-weight: 700; }
    .new-head a { font-size: 0.8rem; color: #797970; text-decoration: none; }
    .new-box ul { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }
    .new-box li a { color: #1a1a1a; text-decoration: none; font-size: 0.9rem; }
    .new-box li a:hover { text-decoration: underline; }
  </style>

  <div class="container">
    <h1>{L('dashboard_greeting', 'Բարե՛ւ, {name}').replace('{name}', displayName(member))}</h1>

    {latest.length > 0 && (
      <section class="new-box">
        <div class="new-head">
          <h2>{L('dashboard_new_title', 'Նոր')}</h2>
          <a href="/platform/notifications">{L('dashboard_new_all', 'Բոլորը')} &rarr;</a>
        </div>
        <ul>
          {latest.map((n) => (
            <li><a href={`/platform/notifications/${n.id}`}>{notificationText(n, L)}</a></li>
          ))}
        </ul>
      </section>
    )}

    <div class="image-row">
      <a class="tile-image" href="/platform/parev">
        <div class="tile-image-figure"><img src="/platform_parev.png" alt="" /></div>
        <div class="tile-image-title">{L('dashboard_tile_parev', 'Բարե՛ւ')}</div>
      </a>
      <a class="tile-image" href="/platform/library">
        <div class="tile-image-figure"><img src="/platform_library.png" alt="" /></div>
        <div class="tile-image-title">{L('dashboard_tile_library', 'Գրադարանս')}</div>
      </a>
      <a class="tile-image" href="/platform/lratu">
        <div class="tile-image-figure"><img class="icon-sm" src="/megaphone.png" alt="" /></div>
        <div class="tile-image-title">{L('dashboard_tile_lratu', 'Լրատու')}</div>
      </a>
    </div>

    <PlatformCalendar workshops={workshops} clouds={clouds} timezone={memberTimezone(member)} memberId={member.id} allMeetings={member.role === 'team'} basePath="/platform" />
  </div>
</PlatformLayout>
