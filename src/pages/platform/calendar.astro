---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import PlatformCalendar from '../../components/PlatformCalendar.astro';
import { requireMember, calendarWorkshops, calendarClouds } from '../../lib/platformAuth';
import { getPlatformLabels, makeLabelGetter } from '../../lib/platformLabels';

const member = await requireMember(Astro.request);
if (!member) {
  return Astro.redirect('/platform/login');
}

const workshops = calendarWorkshops(member);
const clouds = calendarClouds(member);
const L = makeLabelGetter(await getPlatformLabels());
---

<PlatformLayout title="Zartsants Platform — Calendar" member={member}>
  <style>
    .container { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
    h1 { font-size: 1.35rem; font-weight: 700; margin-bottom: 1.5rem; }
  </style>

  <div class="container">
    <h1>{L('calendar_title', 'Calendar')}</h1>
    <PlatformCalendar workshops={workshops} clouds={clouds} basePath="/platform/calendar" />
  </div>
</PlatformLayout>
