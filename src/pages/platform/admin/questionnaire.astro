---
import { requireAdmin } from '../../../lib/platformAuth';
import { adminGet } from '../../../lib/directusAdmin';
import { convertRange } from '../../../lib/timezone';
import {
  WEEKDAYS,
  WEEKDAY_SHORT_LABELS,
  TIMEZONE_GROUPS,
  PROFICIENCY_OPTIONS,
  ADULT_PROFICIENCY_OPTIONS,
  INTEREST_OPTIONS,
  RELATIONSHIP_OPTIONS,
  type Weekday,
  type FormOption,
} from '../../../lib/minorFormContent';

const member = await requireAdmin(Astro.request);
if (!member) {
  return Astro.redirect('/platform');
}

interface Row {
  refId: string;
  participant_name: string;
  email: string;
  respondent_name: string | null;
  participant_type: string | null;
  availability: Partial<Record<Weekday, string[]>> | null;
  timezone: string | null;
  current_school: string | null;
  profession: string | null;
  city: string | null;
  country: string | null;
  participant_birthday: string | null;
  language_proficiency: string[];
  language_proficiency_other: string | null;
  interests: string[];
  interests_other: string | null;
  relationship: string | null;
  relationship_other: string | null;
  availability_other: string | null;
  fee_acknowledged: boolean;
  form_language: string | null;
}

const LEAD_FIELDS =
  'id,participant_name,email,respondent_name,participant_type,availability,timezone,current_school,profession,city,country,participant_birthday,' +
  'language_proficiency,language_proficiency_other,interests,interests_other,relationship,relationship_other,availability_other,' +
  'fee_acknowledged,form_language';

// Legacy: submissions from before this page moved to unmatched_questionnaire_leads
// still live here (they were matched-and-merged into an existing registration).
// Read-only now — nothing new gets written to registration_requests anymore.
const LEGACY_FIELDS =
  'id,full_name,email,respondent_name,participant_type,availability,timezone,current_school,profession,city,country,birthday,' +
  'language_proficiency,language_proficiency_other,interests,interests_other,relationship,relationship_other,availability_other,' +
  'fee_acknowledged,questionnaire_language';

let rows: Row[] = [];
try {
  const [leadsRes, legacyRes] = await Promise.all([
    adminGet(`/items/unmatched_questionnaire_leads?fields=${LEAD_FIELDS}&sort=-id&limit=-1`),
    adminGet(`/items/registration_requests?filter[fee_acknowledged][_eq]=true&fields=${LEGACY_FIELDS}&limit=-1`),
  ]);
  const leads = ((leadsRes.data ?? []) as any[]).map((r) => ({
    ...r,
    refId: `lead#${r.id}`,
    language_proficiency: r.language_proficiency ?? [],
    interests: r.interests ?? [],
  }));
  const legacy = ((legacyRes.data ?? []) as any[]).map((r) => ({
    refId: `reg#${r.id}`,
    participant_name: r.full_name,
    email: r.email,
    respondent_name: r.respondent_name,
    participant_type: r.participant_type,
    availability: r.availability,
    timezone: r.timezone,
    current_school: r.current_school,
    profession: r.profession,
    city: r.city,
    country: r.country,
    participant_birthday: r.birthday,
    language_proficiency: r.language_proficiency ?? [],
    language_proficiency_other: r.language_proficiency_other,
    interests: r.interests ?? [],
    interests_other: r.interests_other,
    relationship: r.relationship,
    relationship_other: r.relationship_other,
    availability_other: r.availability_other,
    fee_acknowledged: r.fee_acknowledged,
    form_language: r.questionnaire_language,
  }));
  rows = [...leads, ...legacy].filter((r) => r.availability && Object.keys(r.availability).length > 0);
} catch (e) {
  console.error('Failed to load questionnaire responses:', e);
}

const requestedTz = Astro.url.searchParams.get('tz');
const targetTz = TIMEZONE_GROUPS.some((g) => g.tz === requestedTz) ? requestedTz! : 'Europe/Paris';

const today = new Date();
const timezoneLabel = (tz: string | null) => TIMEZONE_GROUPS.find((g) => g.tz === tz)?.label.en ?? tz ?? '—';

function resolveLabels(values: string[], options: FormOption[]): string {
  if (!values || values.length === 0) return '—';
  return values.map((v) => options.find((o) => o.value === v)?.label.en ?? v).join(', ');
}

const FORM_LANGUAGE_NAMES: Record<string, string> = { hyw: 'Armenian', fr: 'French', en: 'English' };

const COLS = 6 + WEEKDAYS.length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zartsants Platform — Questionnaire</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        min-height: 100vh;
        background: #9683fe;
        font-family: system-ui, sans-serif;
        color: #000;
      }
      .page {
        padding: 2rem clamp(1.5rem, 6vw, 5rem);
      }
      a.back { color: #000; text-decoration: none; opacity: 0.7; font-size: 0.9rem; }
      h1 { font-size: 1.6rem; font-weight: 700; margin: 1rem 0 0.25rem; }
      p.hint { opacity: 0.7; font-size: 0.9rem; margin-bottom: 1rem; }
      .tz-picker { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.5rem; font-size: 0.9rem; }
      .tz-picker select {
        padding: 0.4rem 0.6rem;
        border-radius: 8px;
        border: 1px solid rgba(0,0,0,0.15);
        background: #fff;
        color: #000;
        font-size: 0.9rem;
        max-width: 360px;
      }
      .table-wrap { overflow-x: auto; background: #fff; border-radius: 12px; padding: 1rem; }
      table { border-collapse: collapse; width: 100%; min-width: 900px; }
      th, td { text-align: left; padding: 0.5rem 0.75rem; font-size: 0.85rem; vertical-align: top; border-bottom: 1px solid rgba(0,0,0,0.08); }
      th { font-weight: 700; white-space: nowrap; }
      td.slots { white-space: nowrap; }
      .empty { opacity: 0.35; }
      tr.main-row { cursor: pointer; }
      tr.main-row:hover { background: rgba(107,92,230,0.05); }
      .chev { display: inline-block; width: 1rem; opacity: 0.5; }
      .id-col { font-family: ui-monospace, monospace; opacity: 0.5; }
      tr.detail-row td { background: #faf9ff; border-bottom: 1px solid rgba(0,0,0,0.08); }
      .detail-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.75rem 1.5rem; padding: 0.5rem 0; }
      .detail-grid dt { font-size: 0.7rem; text-transform: uppercase; opacity: 0.5; margin-bottom: 0.15rem; }
      .detail-grid dd { font-size: 0.85rem; }
    </style>
  </head>
  <body>
    <div class="page">
    <a class="back" href="/platform/admin">&larr; Back</a>
    <h1>Questionnaire availability</h1>
    <p class="hint">Times converted from each respondent's selected timezone to the timezone below. Click a row for the rest of their answers.</p>

    <form method="get" class="tz-picker">
      <label for="tz">View times in:</label>
      <select id="tz" name="tz" onchange="this.form.submit()">
        {TIMEZONE_GROUPS.map((g) => (
          <option value={g.tz} selected={g.tz === targetTz}>{g.label.en}</option>
        ))}
      </select>
    </form>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th></th>
            <th>ID</th>
            <th>Participant</th>
            <th>Respondent</th>
            <th>Type</th>
            <th>Timezone</th>
            {WEEKDAYS.map((day) => <th>{WEEKDAY_SHORT_LABELS[day].en}</th>)}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => {
            const proficiencyOptions = r.participant_type === 'adult' ? ADULT_PROFICIENCY_OPTIONS : PROFICIENCY_OPTIONS;
            return (
              <Fragment>
                <tr
                  class="main-row"
                  onclick="const d=this.nextElementSibling; d.hidden=!d.hidden; this.querySelector('.chev').textContent = d.hidden ? '▸' : '▾';"
                >
                  <td><span class="chev">▸</span></td>
                  <td class="id-col">{r.refId}</td>
                  <td>{r.participant_name}<br /><span style="opacity:0.5">{r.email}</span></td>
                  <td>{r.respondent_name ?? '—'}</td>
                  <td>{r.participant_type ?? '—'}</td>
                  <td>{timezoneLabel(r.timezone)}</td>
                  {WEEKDAYS.map((day) => {
                    const slots = r.availability?.[day] ?? [];
                    return (
                      <td class="slots">
                        {slots.length === 0 || !r.timezone ? (
                          <span class="empty">—</span>
                        ) : (
                          slots.map((s) => <div>{convertRange(s, r.timezone!, targetTz, today)}</div>)
                        )}
                      </td>
                    );
                  })}
                </tr>
                <tr class="detail-row" hidden>
                  <td colspan={COLS}>
                    <dl class="detail-grid">
                      <div><dt>Birthday</dt><dd>{r.participant_birthday ?? '—'}</dd></div>
                      <div><dt>{r.participant_type === 'adult' ? 'Profession' : 'School'}</dt><dd>{(r.participant_type === 'adult' ? r.profession : r.current_school) ?? '—'}</dd></div>
                      <div><dt>City / Country</dt><dd>{[r.city, r.country].filter(Boolean).join(', ') || '—'}</dd></div>
                      <div><dt>Language proficiency</dt><dd>{resolveLabels(r.language_proficiency, proficiencyOptions)}{r.language_proficiency_other ? ` (${r.language_proficiency_other})` : ''}</dd></div>
                      <div><dt>Interests</dt><dd>{resolveLabels(r.interests, INTEREST_OPTIONS)}{r.interests_other ? ` (${r.interests_other})` : ''}</dd></div>
                      {r.participant_type !== 'adult' && (
                        <div><dt>Relationship to participant</dt><dd>{resolveLabels(r.relationship ? [r.relationship] : [], RELATIONSHIP_OPTIONS)}{r.relationship_other ? ` (${r.relationship_other})` : ''}</dd></div>
                      )}
                      <div><dt>Other availability notes</dt><dd>{r.availability_other ?? '—'}</dd></div>
                      <div><dt>Form language</dt><dd>{FORM_LANGUAGE_NAMES[r.form_language ?? ''] ?? r.form_language ?? '—'}</dd></div>
                      <div><dt>Fee acknowledged</dt><dd>{r.fee_acknowledged ? 'Yes' : 'No'}</dd></div>
                    </dl>
                  </td>
                </tr>
              </Fragment>
            );
          })}
          {rows.length === 0 && (
            <tr><td colspan={COLS} style="opacity:0.5">No questionnaire responses with availability yet.</td></tr>
          )}
        </tbody>
      </table>
    </div>
    </div>
  </body>
</html>
