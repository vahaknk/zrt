---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { requireAdmin } from '../../../lib/platformAuth';

const member = await requireAdmin(Astro.request);
if (!member) {
  return Astro.redirect('/platform');
}
---

<PlatformLayout title="Zartsants Platform — Admin" member={member}>
  <style>
    .container { max-width: 780px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
    h1 { font-size: 1.35rem; font-weight: 700; margin-bottom: 1.5rem; }

    .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
    .course {
      display: block;
      background: #fff;
      border: 1px solid #e9e9e4;
      border-radius: 14px;
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      transition: box-shadow 0.15s, transform 0.15s;
    }
    a.course:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.07); transform: translateY(-1px); }
    .course-banner {
      height: 100px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--banner, #f1f0ea);
    }
    .course-banner svg { width: 40px; height: 40px; color: #4a3fcf; }
    .course-body { padding: 0.85rem 1rem 1rem; }
    .course-title { font-weight: 700; font-size: 0.95rem; }
    .course-sub { font-size: 0.78rem; color: #797970; margin-top: 0.2rem; }

    @media (max-width: 480px) {
      .grid { grid-template-columns: 1fr; }
    }
  </style>

  <div class="container">
    <h1>Admin</h1>
    <div class="grid">
      <a class="course" href="/platform/admin/questionnaire">
        <div class="course-banner" style="--banner:#efeaff">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 3v2h6V3M8 10h8M8 14h8M8 18h5"/></svg>
        </div>
        <div class="course-body">
          <div class="course-title">Questionnaire</div>
          <div class="course-sub">Availability by timezone</div>
        </div>
      </a>
      <a class="course" href="/platform/admin/facilitators">
        <div class="course-banner" style="--banner:#fff6d6">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/><path d="M4 21c0-4 3.5-7 8-7s8 3 8 7"/></svg>
        </div>
        <div class="course-body">
          <div class="course-title">Facilitators</div>
          <div class="course-sub">Create a Ուղեկից account</div>
        </div>
      </a>
      <a class="course" href="/platform/admin/members">
        <div class="course-banner" style="--banner:#efeaff">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 12a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z"/><path d="M2.5 20c0-3.5 3-6 6.5-6s6.5 2.5 6.5 6"/><path d="M16 8a3 3 0 1 1 2 5.2"/><path d="M17 14c2.2.4 4 2.1 4 4.5"/></svg>
        </div>
        <div class="course-body">
          <div class="course-title">Members</div>
          <div class="course-sub">Create an account from a registration</div>
        </div>
      </a>
      <a class="course" href="/platform/admin/materials">
        <div class="course-banner" style="--banner:#fff6d6">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 9h18M8 4v5"/></svg>
        </div>
        <div class="course-body">
          <div class="course-title">Materials</div>
          <div class="course-sub">Add a video, audio, or reading</div>
        </div>
      </a>
      <a class="course" href="/platform/admin/schedule">
        <div class="course-banner" style="--banner:#efeaff">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4M9 15l2 2 4-4"/></svg>
        </div>
        <div class="course-body">
          <div class="course-title">Schedule overrides</div>
          <div class="course-sub">Cancel a specific session</div>
        </div>
      </a>
    </div>
  </div>
</PlatformLayout>
