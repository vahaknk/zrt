---
import { directus, readItems } from '../lib/directus';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const lang = form.get('lang') as string;
  Astro.cookies.set('zrt_lang', lang, { path: '/', maxAge: 31536000, sameSite: 'lax' });
  return Astro.redirect('/');
}

interface Language {
  id: string;
  name: string;
  landing_image: string;
  landing_tagline: string;
}

let languages: Language[] = [];
try {
  languages = (await directus.request(readItems('languages' as any))) as Language[];
} catch {
  languages = [{ id: 'en', name: 'English', landing_image: '', landing_tagline: '' }];
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Select Language</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0a0a0a;
        font-family: system-ui, sans-serif;
        color: #fff;
      }
      .card {
        width: 100%;
        max-width: 420px;
        padding: 2.5rem;
        background: #141414;
        border: 1px solid #222;
        border-radius: 12px;
      }
      h1 { font-size: 1.5rem; margin-bottom: 2rem; font-weight: 500; }
      .langs { display: flex; flex-direction: column; gap: 0.75rem; }
      button {
        width: 100%;
        padding: 1rem;
        background: #1e1e1e;
        color: #fff;
        border: 1px solid #333;
        border-radius: 8px;
        font-size: 1rem;
        cursor: pointer;
        text-align: left;
        transition: background 0.2s, border-color 0.2s;
      }
      button:hover { background: #2a2a2a; border-color: #555; }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Choose your language</h1>
      <div class="langs">
        {languages.map((lang) => (
          <form method="POST">
            <input type="hidden" name="lang" value={lang.id} />
            <button type="submit">{lang.name}</button>
          </form>
        ))}
      </div>
    </div>
  </body>
</html>
