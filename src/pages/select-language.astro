---
import { directus, readItems } from '../lib/directus';

interface Language {
  id: string;
  name: string;
  landing_image: string;
  landing_tagline: string;
}

let languages: Language[] = [];
try {
  languages = (await directus.request(readItems('languages' as any))) as Language[];
} catch {
  languages = [{ id: 'hyw', name: 'Արեւمտهایерён', landing_image: '', landing_tagline: '' }];
}

const DIRECTUS_URL = import.meta.env.DIRECTUS_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zartsants</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body {
        width: 100%;
        height: 100%;
        background: #9683fe;
        font-family: system-ui, sans-serif;
        overflow: hidden;
      }
      .grid {
        display: flex;
        width: 100%;
        height: 100%;
      }
      a {
        flex: 1;
        position: relative;
        overflow: hidden;
        text-decoration: none;
        cursor: pointer;
      }
      a img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.4s ease, opacity 0.3s ease;
        opacity: 0.9;
      }
      a:hover img {
        transform: scale(1.04);
        opacity: 1;
      }
      .label {
        position: absolute;
        bottom: 2rem;
        left: 0;
        right: 0;
        text-align: center;
        color: #fff;
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-shadow: 0 2px 8px rgba(0,0,0,0.5);
        opacity: 0;
        transform: translateY(6px);
        transition: opacity 0.3s ease, transform 0.3s ease;
      }
      a:hover .label {
        opacity: 1;
        transform: translateY(0);
      }
      .divider {
        width: 1px;
        background: rgba(255,255,255,0.2);
        flex-shrink: 0;
      }
    </style>
  </head>
  <body>
    <div class="grid">
      {languages.map((lang, i) => (
        <>
          {i > 0 && <div class="divider" />}
          <a href={`/api/set-language?lang=${lang.id}`}>
            {lang.landing_image
              ? <img src={`${DIRECTUS_URL}/assets/${lang.landing_image}`} alt={lang.name} />
              : <div style="width:100%;height:100%;background:#7060cc;" />
            }
            <span class="label">{lang.name}</span>
          </a>
        </>
      ))}
    </div>
  </body>
</html>