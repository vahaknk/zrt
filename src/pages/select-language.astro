---
import { directus, readItems } from '../lib/directus';

interface Language {
  id: string;
  name: string;
  landing_image: string;
  landing_tagline: string;
}

let languages: Language[] = [];
try {
  languages = (await directus.request(readItems('languages' as any))) as Language[];
} catch {
  languages = [{ id: 'hyw', name: 'Արեւمտهایерён', landing_image: '', landing_tagline: '' }];
}

const DIRECTUS_URL = import.meta.env.DIRECTUS_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zartsants</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body {
        width: 100%;
        height: 100%;
        background: #9683fe;
        font-family: system-ui, sans-serif;
      }
      .grid {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        width: 100%;
        height: 100%;
      }
      a {
        display: block;
        width: 220px;
        height: 330px;
        overflow: hidden;
        border-radius: 12px;
        text-decoration: none;
        cursor: pointer;
      }
      a img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.4s ease;
      }
      a:hover img {
        transform: scale(1.05);
      }
    </style>
  </head>
  <body>
    <div class="grid">
      {languages.map((lang) => (
        <a href={`/api/set-language?lang=${lang.id}`}>
          {lang.landing_image
            ? <img src={`${DIRECTUS_URL}/assets/${lang.landing_image}`} alt={lang.name} />
            : <div style="width:200px;height:330px;background:#7060cc;border-radius:12px;" />
          }
        </a>
      ))}
    </div>
  </body>
</html>