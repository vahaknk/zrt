---
import { directus, readItems } from '../lib/directus';

interface Language {
  id: string;
  name: string;
  landing_image: string;
  landing_tagline: string;
}

const ORDER = ['hyw', 'fr', 'en'];

let languages: Language[] = [];
try {
  const result = (await directus.request(readItems('languages' as any))) as Language[];
  languages = result.sort((a, b) => ORDER.indexOf(a.id) - ORDER.indexOf(b.id));
} catch {
  languages = [{ id: 'hyw', name: 'Արեւمտهایерён', landing_image: '', landing_tagline: '' }];
}

const DIRECTUS_URL = import.meta.env.DIRECTUS_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zartsants</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body {
        width: 100%;
        height: 100%;
        background: #9683fe;
        font-family: system-ui, sans-serif;
      }
      .grid {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 60px;
        width: 100%;
        height: 100%;
      }
      a {
        display: block;
        text-decoration: none;
        cursor: pointer;
      }
      a img {
        width: 128px;
        height: 330px;
        object-fit: cover;
        display: block;
        border-radius: 12px;
        transition: transform 0.3s ease;
      }
      a:hover img {
        transform: scale(1.08);
      }
    </style>
  </head>
  <body>
    <div class="grid">
      {languages.map((lang) => (
        <a href={`/?lang=${lang.id}`}>
          {lang.landing_image
            ? <img src={`${DIRECTUS_URL}/assets/${lang.landing_image}`} alt={lang.name} />
            : <div style="width:200px;height:330px;background:#7060cc;border-radius:12px;" />
          }
        </a>
      ))}
    </div>
  </body>
</html>