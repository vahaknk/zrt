---
import { directus, readItems } from '../lib/directus';

interface Language {
  id: string;
  name: string;
  landing_image: string;
  landing_tagline: string;
}

const ORDER = ['hyw', 'fr', 'en'];

let languages: Language[] = [];
try {
  const result = (await directus.request(readItems('languages' as any))) as Language[];
  languages = result.sort((a, b) => {
    const ai = ORDER.indexOf(a.id);
    const bi = ORDER.indexOf(b.id);
    if (ai === -1 && bi === -1) return 0;
    if (ai === -1) return 1;
    if (bi === -1) return -1;
    return ai - bi;
  });
} catch {
  languages = [{ id: 'hyw', name: 'Արեւمتهایерён', landing_image: '', landing_tagline: '' }];
}

const DIRECTUS_URL = import.meta.env.DIRECTUS_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zartsants</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,700;1,400&family=Noto+Sans+Armenian:wght@400;700&display=swap" rel="stylesheet" />
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body {
        width: 100%;
        height: 100%;
        background: #9683fe;
        font-family: 'Noto Sans', 'Noto Sans Armenian', system-ui, sans-serif;
      }
      .page {
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
      }
      .columns {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        align-items: center;
        justify-items: center;
        flex: 1;
        min-height: 0;
        padding: 2.5vh 2.5vw 1.5vh;
        gap: 1.5vw;
      }

      /* Column 1: Logo */
      .col-logo {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        align-self: stretch;
      }
      .col-logo .zartsants-logo {
        width: min(180px, 17vw);
        height: auto;
      }
      .col-logo .gulbenkian-logo {
        position: absolute;
        bottom: 19vh;
        left: 50%;
        transform: translateX(-50%);
        height: min(60px, 6vh);
        width: auto;
      }

      /* Column 2: Door */
      .col-door {
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .door-wrap {
        position: relative;
      }
      .door-wrap img {
        display: block;
        height: min(75vh, 820px);
        width: auto;
      }
      .door-open {
        display: none;
      }

      /* Column 3: Language grid */
      .col-langs {
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .lang-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        column-gap: 1.5vw;
        row-gap: 1vh;
      }
      .lang-card {
        display: block;
        cursor: pointer;
        border-radius: 8px;
        transition: transform 0.2s ease;
      }
      .lang-card:hover {
        transform: scale(1.08);
      }
      .lang-card img {
        width: min(120px, 12vw);
        height: min(26vh, 180px);
        object-fit: contain;
        display: block;
        border-radius: 8px;
      }
      .lang-placeholder {
        width: min(120px, 12vw);
        height: min(26vh, 180px);
        background: #7060cc;
        border-radius: 8px;
      }

      /* Footer */
      .footer {
        display: flex;
        justify-content: center;
        padding: 8px 32px 20px;
        flex-shrink: 0;
      }
      .footer img {
        height: min(48px, 6vh);
        width: auto;
      }

      /* Mobile footer (hidden on desktop) */
      .mobile-footer {
        display: none;
      }

      /* ── Mobile ── */
      @media (max-width: 700px) {
        .page {
          height: auto;
          min-height: 100vh;
          overflow-y: auto;
          padding: 24px 20px 20px;
          gap: 0;
        }
        .columns {
          display: flex;
          flex-direction: column;
          align-items: center;
          padding: 0;
          gap: 0;
          flex: unset;
        }
        /* Hide desktop absolute-positioned Gulbenkian */
        .col-logo .gulbenkian-logo {
          display: none;
        }
        /* Logo at top */
        .col-logo {
          position: static;
          align-self: auto;
          margin-bottom: 20px;
        }
        .col-logo .zartsants-logo {
          width: min(140px, 40vw);
        }
        /* Door centered, moderate size */
        .col-door {
          margin-bottom: 24px;
        }
        .door-wrap img {
          height: min(38vh, 300px);
        }
        /* Language grid */
        .col-langs {
          margin-bottom: 28px;
        }
        .lang-grid {
          column-gap: 3vw;
          row-gap: 3vw;
        }
        .lang-card img {
          width: 25vw;
          height: 32vw;
        }
        .lang-placeholder {
          width: 25vw;
          height: 32vw;
        }
        /* Gulbenkian at bottom */
        .mobile-footer {
          display: flex;
          justify-content: center;
          padding-top: 8px;
        }
        .mobile-footer img {
          height: 40px;
          width: auto;
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <div class="columns">
        <!-- Column 1: Logo + Gulbenkian -->
        <div class="col-logo">
          <img class="zartsants-logo" src="/zartsants-logo.svg" alt="Zartsants" />
          <img class="gulbenkian-logo" src="/gulbenkian-logo.png" alt="Gulbenkian" />
        </div>

        <!-- Column 2: Door (decorative only) -->
        <div class="col-door">
          <div class="door-wrap">
            <img src="/door_open.png" alt="" />
          </div>
        </div>

        <!-- Column 3: 3x3 language grid — click to navigate -->
        <div class="col-langs">
          <div class="lang-grid">
            {languages.map((lang) => (
              <a
                class="lang-card"
                href={`/?lang=${lang.id}`}
              >
                {lang.landing_image
                  ? <img src={`${DIRECTUS_URL}/assets/${lang.landing_image}`} alt={lang.name} />
                  : <div class="lang-placeholder" />
                }
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Mobile only: Gulbenkian at bottom -->
      <div class="mobile-footer">
        <img src="/gulbenkian-logo.png" alt="Gulbenkian" />
      </div>
    </div>

    <script>
      // Navigation is handled by <a href> links — no JS needed.
    </script>
  </body>
</html>