---
import { directus, readItems } from '../lib/directus';
import { getLanguage } from '../lib/language';
import { getLabels } from '../lib/labels';
import AppShell from '../components/AppShell';

const lang = getLanguage(Astro.request);
if (!lang) return Astro.redirect('/select-language');

let sections: any[] = [];
try {
  sections = await directus.request(
    readItems('landing_sections' as any, {
      sort: ['order'],
      fields: ['id', 'order', 'main_image', 'hoover_image', 'bubble', { translations: ['languages_id', 'Header', 'Content'] }] as any,
      deep: {
        translations: { _filter: { languages_id: { _eq: lang } } },
      },
    } as any)
  );
} catch (e) {
  console.error('Failed to fetch sections:', e);
}


let labels: Record<string, string> = {};
try {
  labels = await getLabels(lang);
} catch (e) {
  console.error('Failed to fetch labels:', e);
}

const DIRECTUS_URL = import.meta.env.DIRECTUS_URL;
const DIRECTUS_TOKEN = import.meta.env.DIRECTUS_TOKEN;

let savedLayouts: any[] = [];
try {
  const layoutRes = await fetch(`${DIRECTUS_URL}/items/section_layouts?limit=-1`, {
    headers: { 'Authorization': `Bearer ${DIRECTUS_TOKEN}` },
  });
  const layoutData = await layoutRes.json();
  savedLayouts = layoutData.data ?? [];
} catch {}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zartsants</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,700;1,400&family=Noto+Sans+Armenian:wght@400;700&display=swap" rel="stylesheet" />
    <!-- Content images that appear on bubble click — preloaded to prevent flash -->
    <link rel="preload" as="image" href="/for_whom_click_bubble.webp" />
    <link rel="preload" as="image" href="/what_happens_click_bubble.webp" />
    <link rel="preload" as="image" href="/contactus_content_bubble.webp" />
    <link rel="preload" as="image" href="/conditions_background_image.webp" />
    <link rel="preload" as="image" href="/top-left.webp" />
    <link rel="preload" as="image" href="/bottom-left.webp" />
    <link rel="preload" as="image" href="/top-right.webp" />
    <link rel="preload" as="image" href="/bottom-right.webp" />
    <link rel="preload" as="image" href="/whats_there_1.webp" />
    <link rel="preload" as="image" href="/whats_there_2.webp" />
    <link rel="preload" as="image" href="/whats_there_3.webp" />
    <link rel="preload" as="image" href="/whats_there_4.webp" />
    <link rel="preload" as="image" href="/whats_there_5.webp" />
    <link rel="preload" as="image" href="/whats_there_pic_1.webp" />
    <link rel="preload" as="image" href="/whats_there_pic_2.webp" />
    <link rel="preload" as="image" href="/whats_there_pic_3.webp" />
    <link rel="preload" as="image" href="/whats_there_pic_4.webp" />
    <link rel="preload" as="image" href="/whats_there_pic_5.webp" />
    <link rel="preload" as="image" href="/aboug_us_1.webp" />
    <link rel="preload" as="image" href="/aboug_us_2.webp" />
    <link rel="preload" as="image" href="/aboug_us_3.webp" />
    <link rel="preload" as="image" href="/aboug_us_4.webp" />
    <link rel="preload" as="image" href="/aboug_us_5.webp" />
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      :root { --font-scale: 1; }
      html[lang="gr"] { --font-scale: 0.82; }
      html, body { height: 100%; overflow: hidden; background: #9683fe; color: #000; font-family: 'Noto Sans', 'Noto Sans Armenian', system-ui, sans-serif; }
      *::-webkit-scrollbar { width: 0 !important; height: 0 !important; display: none !important; }
      * { scrollbar-width: none !important; }
      @media (max-width: 899px) {
        html, body { overflow: auto; height: auto; }
      }
    </style>
    <style is:global>

@keyframes bubble-hang {
        0%   { transform: translate(-50%, -50%) rotate(0deg); }
        20%  { transform: translate(-50%, -50%) rotate(-8deg); }
        40%  { transform: translate(-50%, -50%) rotate(6deg); }
        60%  { transform: translate(-50%, -50%) rotate(-4deg); }
        80%  { transform: translate(-50%, -50%) rotate(2deg); }
        100% { transform: translate(-50%, -50%) rotate(0deg); }
      }
      .bubble-hang {
        transform-origin: 50% 0%;
      }
      .bubble-hang:hover {
        animation: bubble-hang 0.8s ease;
        transition: none !important;
      }
      @keyframes logo-hang {
        0%   { transform: rotate(0deg); }
        20%  { transform: rotate(-8deg); }
        40%  { transform: rotate(6deg); }
        60%  { transform: rotate(-4deg); }
        80%  { transform: rotate(2deg); }
        100% { transform: rotate(0deg); }
      }
      .logo-hang {
        transform-origin: 50% 0%;
      }
      .logo-hang:hover {
        animation: logo-hang 0.8s ease;
      }
      @keyframes bird-hang {
        0%   { transform: scaleX(-1) rotate(0deg); }
        20%  { transform: scaleX(-1) rotate(-8deg); }
        40%  { transform: scaleX(-1) rotate(6deg); }
        60%  { transform: scaleX(-1) rotate(-4deg); }
        80%  { transform: scaleX(-1) rotate(2deg); }
        100% { transform: scaleX(-1) rotate(0deg); }
      }
      .bird-hang {
        transform-origin: 50% 0%;
      }
      .bird-hang:hover {
        animation: bird-hang 0.8s ease;
      }
      .contact-content a {
        display: inline-block;
        margin-top: 0.5rem;
        padding: 0.45rem 1.1rem;
        background: #000;
        color: #fff;
        border-radius: 999px;
        font-weight: 700;
        text-decoration: none;
        font-size: clamp(0.8rem, 1.4vh, 1rem);
        transition: background 0.2s;
      }
      .contact-content a:hover {
        background: #333;
      }
    </style>
    <style>
      #mobile-popup {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.85);
        z-index: 99999;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        padding: 24px;
        position: fixed;
      }
      #mobile-popup.visible {
        display: flex;
      }
      #mobile-popup-close {
        position: absolute;
        top: 16px;
        right: 16px;
        width: 36px;
        height: 36px;
        background: rgba(255,255,255,0.15);
        color: #fff;
        border: none;
        border-radius: 50%;
        font-size: 1.2rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
      }
    </style>
  </head>
  <body>
    <div id="mobile-popup">
      <div id="mobile-popup-video-slot" style="width:100%;max-width:420px;"></div>
      <button id="mobile-popup-close">✕</button>
    </div>

    <AppShell
      sections={sections}
      directusUrl={DIRECTUS_URL}
      labels={labels}
      savedLayouts={savedLayouts}
      lang={lang}
      client:only="react"
    />
  </body>
  <script define:vars={{ lang }}>
    if (window.innerWidth <= 899) {
      setTimeout(() => {
        const popup = document.getElementById('mobile-popup');
        const slot = document.getElementById('mobile-popup-video-slot');
        if (popup) popup.classList.add('visible');

        const VIDEO_BY_LANG = {
          de: '/mobile-invite-DE.mp4',
          it: '/mobile-invite-IT.mp4',
          tr: '/mobile-invite-TR.mp4',
          sp: '/mobile-invite-ESP.mp4',
          en: '/mobile-invite-ING.mp4',
          pt: '/mobile-invite-POR.mp4',
          fr: '/mobile-invite-FR.mp4',
        };

        const video = document.createElement('video');
        video.src = VIDEO_BY_LANG[lang] ?? '/mobile-invite.mp4';
        video.muted = true;
        video.loop = true;
        video.setAttribute('autoplay', '');
        video.setAttribute('playsinline', '');
        video.setAttribute('webkit-playsinline', '');
        video.style.cssText = 'width:100%;border-radius:12px;display:block;';
        slot?.appendChild(video);
        video.play().catch(() => {});

        document.getElementById('mobile-popup-close')?.addEventListener('click', () => {
          popup?.classList.remove('visible');
          video.pause();
        });
      }, 3000);
    }
  </script>
  <script>
    let visitorId = localStorage.getItem('zrt_vid');
    if (!visitorId) {
      visitorId = crypto.randomUUID();
      localStorage.setItem('zrt_vid', visitorId);
    }
    const lang = new URLSearchParams(location.search).get('lang') ?? '';
    fetch('/api/track', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ visitor_id: visitorId, language: lang }),
    }).catch(() => {});
  </script>
</html>