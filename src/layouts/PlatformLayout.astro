---
import { displayName, hasFacilitatorPage, memberTimezone, timezoneLabel } from '../lib/platformAuth';
import { getPlatformLabels, makeLabelGetter } from '../lib/platformLabels';
import { unreadCount, listNotifications } from '../lib/notifications';
import { pendingReviewCount } from '../lib/moderation';

export interface Props {
  title: string;
  member: {
    id?: number;
    full_name: string;
    armenian_name?: string | null;
    role?: 'student' | 'facilitator' | 'team' | null;
    moderator?: boolean | null;
    facilitates_workshops?: Array<{ workshops_id: { id: number; name: string } }>;
    facilitates_clouds?: Array<{ clouds_id: { id: number; name: string } }>;
    timezone?: string | null;
    registration_request?: { timezone: string | null } | null;
  };
}

const { title, member } = Astro.props;
const pathname = Astro.url.pathname;
const isActive = (path: string, exact = false) => (exact ? pathname === path : pathname.startsWith(path));
const L = makeLabelGetter(await getPlatformLabels());
// Read by schedule-local.js and PlatformCalendar's script to render times in
// the member's registered timezone; absent means "use the browser's".
const timezone = memberTimezone(member);
const unread = member.id ? await unreadCount(member.id) : 0;
const toReview = member.moderator ? await pendingReviewCount() : 0;
// Newest unread id at page load: the live check only pops up what's newer.
const newestUnread = member.id && unread ? (await listNotifications(member.id, { unreadOnly: true, limit: 1 }))[0]?.id ?? 0 : 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body {
        min-height: 100vh;
        background: #f7f4ee;
        font-family: system-ui, sans-serif;
        color: #1a1a1a;
      }
      /* Keep the footer at the bottom of the screen on short pages: the page
         content grows to fill whatever height the header and footer leave. */
      body { display: flex; flex-direction: column; min-height: 100dvh; }
      .page { flex: 1 0 auto; }
      .topbar {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 0.5rem 1.5rem;
        background: #fff;
        border-bottom: 1px solid #ebe7df;
        flex-wrap: wrap;
      }
      .brand { display: flex; align-items: center; flex-shrink: 0; }
      .brand img { height: 100px; width: auto; display: block; }
      .nav { display: flex; align-items: center; gap: 1.25rem; flex: 1; min-width: 0; overflow-x: auto; }
      .nav a {
        color: #666;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        white-space: nowrap;
        padding: 0.35rem 0;
        border-bottom: 2px solid transparent;
      }
      .nav a:hover { color: #1a1a1a; }
      .nav a.active { color: #1a1a1a; border-bottom-color: #9683fe; }
      .who { display: flex; align-items: center; gap: 1rem; font-size: 0.85rem; color: #555; flex-shrink: 0; }
      .who .name { white-space: nowrap; }
      .who .logout { color: #555; text-decoration: none; white-space: nowrap; }
      .who .logout:hover { text-decoration: underline; }
      .nav-count { display: inline-block; margin-left: 0.35rem; min-width: 18px; padding: 0 5px; box-sizing: border-box; border-radius: 999px; background: #c0392b; color: #fff; font-size: 0.68rem; line-height: 18px; text-align: center; }
      .bell { position: relative; display: inline-flex; color: #797970; padding: 0.2rem; }
      .bell svg { width: 22px; height: 22px; }
      .bell:hover, .bell.has-unread { color: #1a1a1a; }
      .bell .badge[hidden] { display: none; }
      .toast {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        z-index: 50;
        max-width: min(360px, calc(100vw - 2rem));
        background: #1a1a1a;
        color: #fff;
        border-radius: 12px;
        padding: 0.85rem 1.1rem;
        font-size: 0.88rem;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
        text-decoration: none;
        transition: opacity 0.3s, transform 0.3s;
      }
      .toast.hide { opacity: 0; transform: translateY(8px); pointer-events: none; }
      .bell .badge {
        position: absolute;
        top: -4px;
        right: -6px;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        box-sizing: border-box;
        border-radius: 999px;
        background: #c0392b;
        color: #fff;
        font-size: 0.68rem;
        font-weight: 700;
        line-height: 18px;
        text-align: center;
      }

      @media (max-width: 640px) {
        .topbar { padding: 0.5rem 1rem 0; row-gap: 0.25rem; }
        .brand img { height: 52px; }
        .who { margin-left: auto; }
        .who .name { display: none; }
        .nav { order: 3; flex-basis: 100%; gap: 1.1rem; }
        .nav a { padding: 0.55rem 0; }
      }

      .site-footer {
        flex-shrink: 0;
        margin-top: 2rem;
        padding: 1.5rem 1.5rem 2rem;
        border-top: 1px solid #ebe7df;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
      }
      .site-footer img { height: 36px; width: auto; opacity: 0.85; }
      .site-footer .links { display: flex; gap: 1.25rem; font-size: 0.8rem; }
      .site-footer .links a { color: #666; text-decoration: none; }
      .site-footer .links a:hover { color: #1a1a1a; text-decoration: underline; }
    </style>
  </head>
  <body data-tz={timezone ?? undefined} data-tz-label={timezone ? timezoneLabel(timezone) : undefined}>
    <header class="topbar">
      <a class="brand" href="/platform">
        <img src="/zartsants-logo.svg" alt="Zartsants" />
      </a>
      <nav class="nav">
        <a href="/platform" class={isActive('/platform', true) ? 'active' : undefined}>{L('nav_home', 'Իմ էջս')}</a>
        <a href="/platform/calendar" class={isActive('/platform/calendar') ? 'active' : undefined}>{L('nav_calendar', 'Օրացոյցս')}</a>
        <a href="/platform/library" class={isActive('/platform/library') ? 'active' : undefined}>{L('nav_library', 'Գրադարանս')}</a>
        {member.id && (
          <a href="/platform/inbox" class={isActive('/platform/inbox') || isActive('/platform/submissions') ? 'active' : undefined}>
            {L('nav_inbox', 'Նամակատուփս')}
          </a>
        )}
        {hasFacilitatorPage(member) && (
          <a href="/platform/facilitator" class={isActive('/platform/facilitator') ? 'active' : undefined}>{L('nav_facilitator', 'Փեթակ')}</a>
        )}
        {member.moderator && (
          <a href="/platform/review" class={isActive('/platform/review') ? 'active' : undefined}>
            {L('nav_review', 'Ստուգում')}{toReview > 0 && <span class="nav-count">{toReview}</span>}
          </a>
        )}
      </nav>
      <div class="who">
        {member.id && (
          <a class={`bell ${unread ? 'has-unread' : ''}`} id="bell" data-newest={newestUnread} href="/platform/notifications" aria-label={L('notifications_title', 'Ծանուցումներ')} title={L('notifications_title', 'Ծանուցումներ')}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Zm7-6V11a7 7 0 0 0-5.5-6.84V3.5a1.5 1.5 0 0 0-3 0v.66A7 7 0 0 0 5 11v5l-1.7 1.7A1 1 0 0 0 4 19.4h16a1 1 0 0 0 .7-1.7Z" fill="currentColor"/></svg>
            <span class="badge" hidden={unread === 0}>{unread > 99 ? '99+' : unread}</span>
          </a>
        )}
        <span class="name">{displayName(member)}</span>
        <a class="logout" href="/api/platform/logout">{L('nav_logout', 'Log out')}</a>
      </div>
    </header>
    <main class="page">
      <slot />
    </main>
    <footer class="site-footer">
      <img src="/gulbenkian-logo-arm.png" alt="Gulbenkian" />
      <div class="links">
        <a href="https://zartsants.com" target="_blank" rel="noopener">zartsants.com</a>
        <a href="https://www.instagram.com/zartsants/" target="_blank" rel="noopener">Instagram</a>
        <a href="https://www.facebook.com/profile.php?id=61591820653723" target="_blank" rel="noopener">Facebook</a>
        <a href="/privacy">{L('footer_privacy', 'Privacy policy')}</a>
      </div>
    </footer>
    <script is:inline src="/schedule-local.js" defer></script>
    <script
      type="application/json"
      id="recorder-labels"
      set:html={JSON.stringify({
        title: L('recorder_title', 'Ձայնագրութիւն'),
        start: L('recorder_start', 'Սկսիլ'),
        stop: L('recorder_stop', 'Կեցնել'),
        use: L('recorder_use', 'Գործածել'),
        again: L('recorder_again', 'Վերստին'),
        cancel: L('recorder_cancel', 'Չեղարկել'),
        denied: L('recorder_denied', 'Խօսափողը չենք կրնար գործածել։ Թոյլատրէ զայն զննարկիչիդ կարգաւորումներուն մէջ։'),
        unsupported: L('recorder_unsupported', 'Այս զննարկիչը ձայնագրութիւն չ՚արտօներ։'),
        limit: L('recorder_limit', 'Առաւելագոյնը 5 վայրկեան'),
        fileName: L('recorder_file_name', 'Ձայնագրութիւն'),
      }).replace(/</g, '\\u003c')}
    />
  <script>
      // Live notifications: every 30 s while the tab is visible (and when it
      // comes back), refresh the bell's count and pop up anything new.
      const bell = document.getElementById('bell');
      if (bell) {
        const badge = bell.querySelector<HTMLElement>('.badge')!;
        let newest = Number(bell.dataset.newest ?? 0);
        const toast = (id: number, text: string) => {
          const el = document.createElement('a');
          el.className = 'toast hide';
          el.href = `/platform/notifications/${id}`;
          el.textContent = text;
          document.body.appendChild(el);
          requestAnimationFrame(() => el.classList.remove('hide'));
          setTimeout(() => {
            el.classList.add('hide');
            setTimeout(() => el.remove(), 400);
          }, 8000);
        };
        const check = async () => {
          if (document.visibilityState !== 'visible') return;
          const res = await fetch('/api/platform/notifications', { cache: 'no-store' }).catch(() => null);
          if (!res?.ok) return;
          const { count, latest } = (await res.json()) as { count: number; latest: Array<{ id: number; text: string }> };
          badge.textContent = count > 99 ? '99+' : String(count);
          badge.hidden = count === 0;
          bell.classList.toggle('has-unread', count > 0);
          const fresh = latest.filter((n) => n.id > newest);
          if (fresh.length) {
            newest = Math.max(...fresh.map((n) => n.id));
            toast(fresh[0].id, fresh[0].text);
          }
        };
        setInterval(check, 30000);
        document.addEventListener('visibilitychange', check);
      }
    </script>
  </body>
</html>
